<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Analyzer and style rules count as warnings too, so they also stop the build. Rules are tuned in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The unused-using check only runs on build when documentation is generated; undocumented members and parameters are not an error. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <!-- The core is grouped by what each part does. Every project sees all five parts, so no file lists them. -->
  <ItemGroup>
    <Using Include="PoAutoRobo.Core.Library" />
    <Using Include="PoAutoRobo.Core.Script" />
    <Using Include="PoAutoRobo.Core.Voice" />
    <Using Include="PoAutoRobo.Core.Pictures" />
    <Using Include="PoAutoRobo.Core.Render" />
  </ItemGroup>
</Project>
