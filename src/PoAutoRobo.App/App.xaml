<Application
    x:Class="PoAutoRobo.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No RequestedTheme: the app follows the light or dark setting in Windows. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Frosted glass, for the clip cards: it blurs what moves behind it, and its edge catches the light at the top left. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="GlassBrush" TintColor="#FFFFFF" TintOpacity="0.45" TintLuminosityOpacity="0.55" FallbackColor="#F3F3F3" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#F2FFFFFF" />
                        <GradientStop Offset="1" Color="#33FFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="GlassBrush" TintColor="#1C1C1C" TintOpacity="0.4" TintLuminosityOpacity="0.5" FallbackColor="#2B2B2B" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#59FFFFFF" />
                        <GradientStop Offset="1" Color="#0DFFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The app's measurements, named once. Change one here and every page that uses it follows. -->
            <!-- Room between a page's edge and what is on it, and between the header's edge and its controls. -->
            <Thickness x:Key="PagePadding">16</Thickness>
            <Thickness x:Key="HeaderPadding">16,4</Thickness>
            <Thickness x:Key="DeckPadding">12</Thickness>
            <!-- Room between neighbouring things: controls in a group, then groups, then columns. -->
            <x:Double x:Key="GapSmall">8</x:Double>
            <x:Double x:Key="Gap">12</x:Double>
            <x:Double x:Key="GapLarge">16</x:Double>
            <!-- The fixed column beside each page's main area. Each narrows in a small window; see the pages' own states. -->
            <GridLength x:Key="FormColumn">380</GridLength>
            <GridLength x:Key="InspectorColumn">360</GridLength>
            <GridLength x:Key="ExportColumn">280</GridLength>
            <!-- The intro page's settings, beside the intro playing as large as the window allows. -->
            <GridLength x:Key="IntroColumn">360</GridLength>
            <!-- A clip card's size, shared with the placeholder cards shown while a script is written. -->
            <x:Double x:Key="CardWidth">176</x:Double>
            <x:Double x:Key="CardPictureHeight">99</x:Double>
            <!-- A saved episode in the list on the topic page. -->
            <x:Double x:Key="LibraryItemWidth">264</x:Double>
            <x:Double x:Key="LibraryItemHeight">64</x:Double>
            <!-- A teaser's card on the Publish step: three side by side fill the room beside the column in a full window. -->
            <x:Double x:Key="TeaserCardWidth">300</x:Double>
            <!-- The floating bar that shows a job under way and the last message, over the foot of every page. -->
            <x:Double x:Key="DockWidth">720</x:Double>

            <!-- The app's few shared looks, named once so every view uses the same ones. -->
            <!-- Small grey supporting text: counts, hints, source lines. -->
            <Style x:Key="QuietText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- Small amber text for something worth a second look that does not stop the work. -->
            <Style x:Key="CautionText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- A label laid over a picture. -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
            <!-- A mark on a clip's picture for something worth a second look. Each kind of thing has its own colour and sign. -->
            <Style x:Key="Mark" TargetType="Border">
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <!-- The heading over a group of controls. -->
            <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <!-- A square button that shows only an icon, large enough to hit with a finger. -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- A round play button laid over a picture, in its bottom-right corner: a clip's card, a teaser's card. -->
            <Style x:Key="PlayOverPicture" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>


            <!--
              What a placeholder is filled with while its content loads: a soft band of light that crosses the whole
              window, so every placeholder catches it in turn. One brush, moved by the window, shared by them all.
              Mid grey at low strength, which reads as lighter than a dark page and darker than a light one.
            -->
            <LinearGradientBrush x:Key="ShimmerBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="600,0" SpreadMethod="Repeat">
                <LinearGradientBrush.Transform>
                    <TranslateTransform />
                </LinearGradientBrush.Transform>
                <GradientStop Offset="0" Color="#22808080" />
                <GradientStop Offset="0.5" Color="#66808080" />
                <GradientStop Offset="1" Color="#22808080" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
