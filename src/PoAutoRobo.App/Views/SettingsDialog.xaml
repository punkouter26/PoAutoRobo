<ContentDialog
    x:Class="PoAutoRobo.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PoAutoRobo.App"
    Title="Settings"
    CloseButtonText="Done"
    DefaultButton="Close">
    <!-- Everything the app remembers between runs that is not part of an episode, saved as it is changed. -->
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Width="380" Spacing="{StaticResource GapSmall}">
            <TextBlock Text="Pictures" Style="{StaticResource SectionHeading}" />
            <ToggleSwitch x:Name="DraftPicturesSwitch" Header="Draft-quality pictures" IsOn="{x:Bind ViewModel.DraftPictures, Mode=TwoWay}"
                          ToolTipService.ToolTip="Draw pictures at low quality: quicker and well under half the price. Turn it off and generate again for the pictures you will publish." />

            <TextBlock Text="Spending" Style="{StaticResource SectionHeading}" />
            <NumberBox x:Name="BudgetBox" Header="Monthly budget in dollars (0 for none)" Minimum="0" SmallChange="5" LargeChange="20" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MonthlyBudget, Mode=TwoWay}"
                       ToolTipService.ToolTip="Once this month's spending across every episode would pass this, the app stops before making anything that costs money." />
            <TextBlock x:Name="SpendText" Text="{x:Bind ViewModel.SpendDetail, Mode=OneWay}" Style="{StaticResource QuietText}" IsTextSelectionEnabled="True"
                       ToolTipService.ToolTip="What the open episode has spent so far, by kind and dearest first, and this month's total across every episode. Worked out afresh each time Settings opens." />

            <TextBlock Text="Controls" Style="{StaticResource SectionHeading}" />
            <ToggleSwitch x:Name="AdvancedSwitch" Header="Advanced controls" IsOn="{x:Bind ViewModel.Advanced, Mode=TwoWay}"
                          ToolTipService.ToolTip="Shows the controls most episodes never need: each clip's depth (A, B or C), host switch, picture type, another take, earlier takes and the robot's-eye view; the Jobs menu on the Clips step; designing a host and the outro's length on the Intro step; caption size and outline; each teaser's moments and framing; 4K or 60 fps video, just below; and the services' model names. Turned off, the video size goes back to 1080p at 30 fps and teasers to their suggested cuts; anything already set away from the standard keeps its control in view." />
            <ComboBox x:Name="ExportPresetBox" Header="Video size" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.ExportChoices}" SelectedIndex="{x:Bind ViewModel.ExportPresetIndex, Mode=TwoWay}"
                      ToolTipService.ToolTip="Size and smoothness of the master video made on the Publish step. 4K and 60 fps take much longer to render. Kept for next time, and back to 1080p at 30 fps when advanced controls are turned off." />

            <TextBlock Text="Services" Style="{StaticResource SectionHeading}" />
            <TextBlock x:Name="LiveText" Style="{StaticResource QuietText}" TextWrapping="Wrap" />
            <ToggleSwitch x:Name="VideoSwitch" Header="AI video" IsOn="{x:Bind Services.Video, Mode=TwoWay}"
                          ToolTipService.ToolTip="Offers a short AI-made video for a clip. Each one costs more than a picture, and you are shown the cost and asked first." />
            <TextBox Header="Video model" Text="{x:Bind Services.VideoModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind Services.ShowVideoModel, Mode=OneWay}"
                     ToolTipService.ToolTip="The name of the video deployment on your Azure AI resource, exactly as it is named there. Used from the next time the app starts." />
            <ToggleSwitch x:Name="StockSwitch" Header="Stock photos" IsOn="{x:Bind Services.StockPhotos, Mode=TwoWay}"
                          ToolTipService.ToolTip="Offers real photographs from Pexels, free, with the Pexels key in your vault." />
            <ToggleSwitch x:Name="LocalSwitch" Header="Small jobs on this computer" IsOn="{x:Bind Services.Local, Mode=TwoWay}"
                          ToolTipService.ToolTip="A model run on this computer in Ollama does the small jobs for free: checking a picture still fits, search terms, teaser ideas and upload notes. Ollama must be running; without it the fast model does them." />
            <TextBox Header="Local model" Text="{x:Bind Services.LocalModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind Services.ShowLocalModel, Mode=OneWay}"
                     ToolTipService.ToolTip="The model's name in Ollama, such as qwen3:8b. It must already be downloaded there. Used from the next time the app starts." />
            <ToggleSwitch x:Name="MeaningSwitch" Header="Find passages by meaning" IsOn="{x:Bind Services.Meaning, Mode=TwoWay}"
                          ToolTipService.ToolTip="Finds the passages of the robot's documentation a script is written from by what they mean, not only by the words they share. Costs a little each time a script is written." />
            <TextBox Header="Embedding model" Text="{x:Bind Services.EmbeddingModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind Services.ShowEmbeddingModel, Mode=OneWay}"
                     ToolTipService.ToolTip="The name of the embedding deployment on your Azure AI resource, exactly as it is named there. Used from the next time the app starts." />
            <TextBlock x:Name="OutsideText" Style="{StaticResource QuietText}" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Spacing="{StaticResource GapSmall}" Visibility="{x:Bind Services.NeedsRestart, Mode=OneWay}">
                <TextBlock Style="{StaticResource QuietText}" TextWrapping="Wrap" Text="Services are set up as the app starts, so this change takes effect when it starts again." />
                <Button x:Name="RestartButton" Content="Restart now" Click="OnRestart" IsEnabled="{x:Bind app:Ui.Not(ViewModel.IsWorking), Mode=OneWay}"
                        ToolTipService.ToolTip="Closes the app and opens it again, back where you are. Not while a job is running." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
