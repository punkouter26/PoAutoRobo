<UserControl
    x:Class="PoAutoRobo.App.Views.TopicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoAutoRobo.App.Views"
    xmlns:library="using:PoAutoRobo.Core.Library"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Loaded="OnLoaded" Unloaded="OnUnloaded" ActualThemeChanged="OnThemeChanged">
    <!-- Left: start something new. Right: carry on with something saved. -->
    <Grid>
        <!-- In a small window the form gives some of its width to the saved episodes. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FormColumn.Width" Value="320" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FormColumn" Width="{StaticResource FormColumn}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The topic box takes whatever height the two choices and the button leave it. -->
        <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}" ColumnSpacing="{StaticResource GapSmall}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SubjectBox" Header="About" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.SubjectChoices}" SelectedIndex="{x:Bind ViewModel.SubjectIndex, Mode=TwoWay}"
                      ToolTipService.ToolTip="Unitree R1: facts come from the official Unitree, Isaac Lab and MuJoCo repositories. Any topic: written from what you type alone, so paste in the facts you want used. Video essay: any topic, no host, one argument told in visual metaphors." />
            <ComboBox x:Name="LengthBox" Grid.Column="1" Header="Length" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.LengthChoices}" SelectedIndex="{x:Bind ViewModel.LengthIndex, Mode=TwoWay}"
                      ToolTipService.ToolTip="How many clips to write. Full is 15 to 20 clips, about 10 minutes; Short is 5, about 3 minutes; Quick test is one clip of about 30 seconds, to try every step and render in a minute or two; Sampler is 9, enough for one of each picture type." />
            <TextBox x:Name="TopicBox" Grid.Row="1" Grid.ColumnSpan="2" ToolTipService.ToolTip="The one subject of this episode. A sentence is enough; an outline, paper abstract or code snippet also works. Ctrl+Enter writes the script." Header="Your own topic" PlaceholderText="Paste a topic, outline, abstract or code"
                     Text="{x:Bind ViewModel.TopicInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxLength="8000" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="TopicCountText" Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.TopicCount, Mode=OneWay}" Style="{StaticResource QuietText}" Margin="0,-6,0,0" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="CreateEpisodeButton" Grid.Row="3" Grid.ColumnSpan="2" MinHeight="44" ToolTipService.ToolTip="Write the script on this topic (Ctrl+Enter). Progress is shown at the top, with a Cancel button." Content="Create episode" Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CreateEpisodeCommand}" />
        </Grid>

        <!-- A slow cloud of light in the accent colour, worked out on the graphics card behind the saved episodes -->
        <canvas:CanvasAnimatedControl x:Name="Backdrop" Grid.Column="1" Draw="OnDrawBackdrop" ClearColor="Transparent" IsHitTestVisible="False" IsTabStop="False"
                                      AutomationProperties.AccessibilityView="Raw" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource Gap}">
                <TextBlock Text="Saved episodes" Style="{ThemeResource BodyStrongTextBlockStyle}" Visibility="{x:Bind ViewModel.HasLibrary, Mode=OneWay}" />
                <!-- Scrolls by itself within a few rows, so only the episodes in view are built however many are saved -->
                <GridView x:Name="Library" ItemsSource="{x:Bind ViewModel.Library}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOpenEpisode"
                          MaxHeight="232" AutomationProperties.Name="Saved episodes"
                          Visibility="{x:Bind ViewModel.HasLibrary, Mode=OneWay}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="library:EpisodeSummary">
                            <Grid Width="{StaticResource LibraryItemWidth}" Height="{StaticResource LibraryItemHeight}" ColumnSpacing="10" Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind local:ClipCard.ToImage(Thumbnail)}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Tip}">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource QuietText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Center" AutomationProperties.Name="Episode actions" ToolTipService.ToolTip="Copy, find or delete this episode">
                                    <SymbolIcon Symbol="More" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="OnOpenFromMenu" />
                                            <MenuFlyoutItem Text="Make a copy" Tag="{x:Bind}" Click="OnDuplicateEpisode" />
                                            <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowEpisode" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete…" Tag="{x:Bind}" Click="OnDeleteEpisode" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
