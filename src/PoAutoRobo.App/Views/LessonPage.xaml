<UserControl
    x:Class="PoAutoRobo.App.Views.LessonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoAutoRobo.App.Views"
    xmlns:app="using:PoAutoRobo.App"
    xmlns:vm="using:PoAutoRobo.App.ViewModels"
    xmlns:library="using:PoAutoRobo.Core.Library">
    <!-- Left: start something new. Right: carry on with something saved. -->
    <Grid>
        <!-- In a small window the form gives some of its width to the saved episodes. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FormColumn.Width" Value="320" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FormColumn" Width="{StaticResource FormColumn}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The lesson, top to bottom in the order it is thought of; the button stays in view below the form. -->
        <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                <StackPanel Spacing="{StaticResource Gap}">
                    <NumberBox x:Name="NumberBox" Header="Episode" Minimum="1" Maximum="999" SpinButtonPlacementMode="Compact" MinWidth="110" HorizontalAlignment="Left"
                               Value="{x:Bind ViewModel.EpisodeNumber, Mode=TwoWay}" ToolTipService.ToolTip="Where this episode comes in the series. The next number is filled in; change it to redo or skip one." />
                    <TextBox x:Name="TaughtBox" Header="What I taught it" PlaceholderText="Walking up three stairs without the handrail"
                             ToolTipService.ToolTip="What the R1 learned in this episode. A sentence is enough; notes or code also work. Ctrl+Enter writes the script."
                             Text="{x:Bind ViewModel.TopicInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220" MaxLength="8000" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="TopicCountText" Text="{x:Bind ViewModel.TopicCount, Mode=OneWay}" Style="{StaticResource QuietText}" Margin="0,-6,0,0" AutomationProperties.LiveSetting="Polite" />
                    <TextBox x:Name="WentWrongBox" Header="What went wrong (optional)" PlaceholderText="It leaned back and sat down on the second step"
                             ToolTipService.ToolTip="What went wrong along the way, in a sentence or two. It goes to the script writer with what you taught, so the episode can tell that part of the story. Leave it empty if nothing did."
                             Text="{x:Bind ViewModel.WentWrongInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" MaxLength="2000" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Grid>
                        <TextBlock Text="My footage" VerticalAlignment="Center" />
                        <Button x:Name="AddFootageButton" HorizontalAlignment="Right" Click="OnAddFootage" AllowDrop="True" DragOver="OnFootageDragOver" Drop="OnFootageDrop"
                                ToolTipService.ToolTip="Add films of the robot (2 seconds to 2 minutes each), or drop them here. The script places each one in the beat its note fits.">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Add films" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="No films yet. Episodes with none are made of pictures only." Style="{StaticResource QuietText}" TextWrapping="Wrap"
                               Visibility="{x:Bind app:Ui.ShowIf(ViewModel.Footage.Count, 0), Mode=OneWay}" />
                    <ItemsControl x:Name="FootageList" ItemsSource="{x:Bind ViewModel.Footage}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FootageRow">
                                <Grid Padding="10" Margin="0,0,0,8" RowSpacing="6" ColumnSpacing="{StaticResource GapSmall}" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}">
                                        <Run Text="{x:Bind Name}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{x:Bind LengthText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind OwnSound, Mode=TwoWay}" OnContent="My sound" OffContent="Narrate" MinWidth="0" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="My sound: the film plays with its own sound. Narrate: the narrator speaks over it, fitted to its length." />
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                            AutomationProperties.Name="Suggest a note" ToolTipService.ToolTip="Suggest a note: a model watches a few frames of the film and says what it shows. A cent or two, once per film." Tag="{x:Bind}" Click="OnSuggestNote">
                                        <SymbolIcon Symbol="View" />
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                            AutomationProperties.Name="Remove film" ToolTipService.ToolTip="Leave this film out of the lesson. Your file is not deleted; add it again with Add films." Tag="{x:Bind}" Click="OnRemoveFootage">
                                        <SymbolIcon Symbol="Cancel" />
                                    </Button>
                                    <TextBox Grid.Row="1" Grid.ColumnSpan="4" PlaceholderText="What it shows: first try, falls over" Text="{x:Bind Note, Mode=TwoWay}" MaxLength="200"
                                             AutomationProperties.Name="What the film shows"
                                             ToolTipService.ToolTip="A few words on what this film shows. The script uses them to place the film in the beat it fits. The eye button beside it can suggest some." />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="CreateEpisodeButton" Grid.Row="1" MinHeight="44" ToolTipService.ToolTip="Write the script for this lesson (Ctrl+Enter). Progress is shown at the top, with a Cancel button." Content="Write the script" Style="{x:Bind app:Ui.Primary(ViewModel.WriteIsNext), Mode=OneWay}"
                    HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CreateEpisodeCommand}" />
        </Grid>

        <!-- The saved episodes -->
        <Grid Grid.Column="1" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Saved episodes" Style="{ThemeResource BodyStrongTextBlockStyle}" Visibility="{x:Bind ViewModel.HasLibrary, Mode=OneWay}" />
            <!-- Scrolls by itself, so only the episodes in view are built however many are saved -->
            <GridView x:Name="Library" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Library}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOpenEpisode"
                      AutomationProperties.Name="Saved episodes"
                      Visibility="{x:Bind ViewModel.HasLibrary, Mode=OneWay}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="library:EpisodeSummary">
                        <Grid Width="{StaticResource LibraryItemWidth}" Height="{StaticResource LibraryItemHeight}" ColumnSpacing="10" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" ToolTipService.ToolTip="Click to open this episode and carry on with it.">
                                <Image Source="{x:Bind local:ClipCard.ToImage(Thumbnail)}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Tip}">
                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource QuietText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Center" AutomationProperties.Name="Episode actions" ToolTipService.ToolTip="Open, copy, find or delete this episode. Clicking the episode itself opens it.">
                                <SymbolIcon Symbol="More" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="OnOpenFromMenu" ToolTipService.ToolTip="Open this episode to carry on with it." />
                                        <MenuFlyoutItem Text="Make a copy" Tag="{x:Bind}" Click="OnDuplicateEpisode"
                                                        ToolTipService.ToolTip="Save a second copy of this episode, with every picture and recording, to try something different without touching the first. Nothing is paid for again." />
                                        <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowEpisode"
                                                        ToolTipService.ToolTip="Open this episode's folder, with its script, voices, pictures and finished videos, in File Explorer." />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete…" Tag="{x:Bind}" Click="OnDeleteEpisode"
                                                        ToolTipService.ToolTip="Move this episode's folder, with everything made for it, to the Recycle Bin. You are asked first." />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</UserControl>
