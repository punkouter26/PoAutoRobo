<UserControl
    x:Class="PoAutoRobo.App.Views.RadarPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoAutoRobo.App.Views"
    xmlns:services="using:PoAutoRobo.Core.Services">
    <!-- Left: start something new. Right: carry on with something saved, or take a story from the radar. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Padding="16" Spacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBox x:Name="TopicBox" ToolTipService.ToolTip="The one subject of this episode. A sentence is enough; an outline, paper abstract or code snippet also works." Header="Your own topic" PlaceholderText="Paste a topic, outline, abstract or code"
                     Text="{x:Bind ViewModel.TopicInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="180" MaxLength="8000" />
            <ComboBox x:Name="LengthBox" Header="Episode length" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.LengthChoices}" SelectedIndex="{x:Bind ViewModel.LengthIndex, Mode=TwoWay}"
                      ToolTipService.ToolTip="How many clips to write. Quick test makes a single clip of about 30 seconds, so you can try every step and render in a minute or two." />
            <Button x:Name="CreateEpisodeButton" ToolTipService.ToolTip="Read the official repositories and write the script on this topic. Progress is shown at the top, with a Cancel button." Content="Create episode" Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CreateEpisodeCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16" Spacing="12">
                <TextBlock Text="Saved episodes" Style="{ThemeResource BodyStrongTextBlockStyle}" Visibility="{x:Bind ViewModel.HasLibrary, Mode=OneWay}" />
                <GridView x:Name="Library" ItemsSource="{x:Bind ViewModel.Library}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOpenEpisode"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.Name="Saved episodes"
                          Visibility="{x:Bind ViewModel.HasLibrary, Mode=OneWay}"
                          ToolTipService.ToolTip="Carry on with an episode you made earlier. Everything is saved as you go.">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="services:EpisodeSummary">
                            <Grid Width="264" Height="64" ColumnSpacing="10" Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind local:ClipCard.ToImage(Thumbnail)}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Tip}">
                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource QuietText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" VerticalAlignment="Center" AutomationProperties.Name="Episode actions" ToolTipService.ToolTip="Copy, find or delete this episode">
                                    <SymbolIcon Symbol="More" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open" Tag="{x:Bind}" Click="OnOpenFromMenu" />
                                            <MenuFlyoutItem Text="Make a copy" Tag="{x:Bind}" Click="OnDuplicateEpisode" />
                                            <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind}" Click="OnShowEpisode" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete…" Tag="{x:Bind}" Click="OnDeleteEpisode" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Grid>
                    <TextBlock Text="Topic radar" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RefreshTopicsButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Command="{x:Bind ViewModel.RefreshTopicsCommand}" AutomationProperties.Name="Refresh topics" ToolTipService.ToolTip="Look for new Unitree R1 stories.">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.RefreshTopicsCommand.IsRunning, Mode=OneWay}" />
                <ItemsControl x:Name="TopicCards" ItemsSource="{x:Bind ViewModel.Topics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:TopicCard">
                            <Grid ColumnSpacing="12" Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyStrongTextBlockStyle}" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Summary}" MaxLines="2" TextTrimming="CharacterEllipsis" Style="{StaticResource QuietText}" ToolTipService.ToolTip="{x:Bind Summary}" />
                                    <HyperlinkButton Padding="0" NavigateUri="{x:Bind Url}">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                                            <Run Text="{x:Bind Source}" /><Run Text="  " /><Run Text="{x:Bind Interest}" />
                                        </TextBlock>
                                    </HyperlinkButton>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Adopt topic" VerticalAlignment="Center" Tag="{x:Bind}" Click="OnAdoptTopic" ToolTipService.ToolTip="Use this story as the episode topic and start writing the script straight away." />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
