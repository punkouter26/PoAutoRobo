<ContentDialog
    x:Class="PoAutoRobo.App.Views.SeriesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PoAutoRobo.App.ViewModels"
    Title="Series"
    CloseButtonText="Done"
    DefaultButton="Close">
    <!-- Wider than a dialog's usual limit, so the settings and the intro sit side by side. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>
    <!-- Left: what every episode shares, saved as it is changed. Right: the intro as it will look, drawn on request. -->
    <Grid ColumnSpacing="{StaticResource GapLarge}" MaxWidth="900">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel Spacing="{StaticResource Gap}">
                <TextBox x:Name="ChannelBox" Header="Channel name" PlaceholderText="Teaching the R1" Text="{x:Bind ViewModel.SeriesChannel, Mode=TwoWay}" MaxLength="60"
                         ToolTipService.ToolTip="Shown large in every intro and outro. Without one, episodes are exported with no intro or outro." />
                <TextBox x:Name="TaglineBox" Header="Tagline" PlaceholderText="One skill at a time" Text="{x:Bind ViewModel.SeriesTagline, Mode=TwoWay}" MaxLength="80" />

                <TextBlock Text="Files" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="{StaticResource GapSmall}" RowSpacing="{StaticResource GapSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Logo" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SeriesLogoLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="Pick…" Tag="logo" Click="OnPick" ToolTipService.ToolTip="A PNG, best with a see-through background. Shown in the corner of the intro and outro." />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="logo" Click="OnClear" AutomationProperties.Name="No logo"><SymbolIcon Symbol="Cancel" /></Button>

                    <TextBlock Grid.Row="1" Text="Sting" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SeriesStingLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Pick…" Tag="sting" Click="OnPick" ToolTipService.ToolTip="A few seconds of music for the intro. Anything past five seconds is cut." />
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource IconButton}" Tag="sting" Click="OnClear" AutomationProperties.Name="No sting"><SymbolIcon Symbol="Cancel" /></Button>

                    <TextBlock Grid.Row="2" Text="Music" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SeriesMusicLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Pick…" Tag="music" Click="OnPick" ToolTipService.ToolTip="Played quietly under every new episode, dipping whenever someone speaks." />
                    <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource IconButton}" Tag="music" Click="OnClear" AutomationProperties.Name="No music"><SymbolIcon Symbol="Cancel" /></Button>

                    <TextBlock Grid.Row="3" Text="Mascot" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SeriesMascotLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="3" Grid.Column="2" Content="Pick…" Tag="mascot" Click="OnPick" ToolTipService.ToolTip="A PNG of the mascot, shown beside the words in the intro and outro." />
                    <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource IconButton}" Tag="mascot" Click="OnClear" AutomationProperties.Name="No mascot"><SymbolIcon Symbol="Cancel" /></Button>
                </Grid>
                <Button x:Name="HostMascotButton" Content="Use the host design as the mascot" Command="{x:Bind ViewModel.UseHostAsMascotCommand}" HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind vm:MainViewModel.HasHostDesign}"
                        ToolTipService.ToolTip="The cartoon robot chosen under Choose host. It is made once, so using it here costs nothing." />

                <TextBlock Text="Look of new episodes" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="LookBox" Header="Pictures" HorizontalAlignment="Stretch" ItemsSource="{x:Bind vm:MainViewModel.LookChoices}" SelectedIndex="{x:Bind ViewModel.SeriesLookIndex, Mode=TwoWay}" />
                <ComboBox x:Name="CaptionBox" Header="Captions" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.CaptionChoices}" SelectedIndex="{x:Bind ViewModel.SeriesCaptionIndex, Mode=TwoWay}" />
                <TextBox x:Name="AccentBox" Header="Accent colour" PlaceholderText="#FFD400" Text="{x:Bind ViewModel.SeriesAccent, Mode=TwoWay}" MaxLength="7"
                         ToolTipService.ToolTip="As #RRGGBB. Used for the intro and outro background, the section straps and the captions." />
                <NumberBox x:Name="OutroBox" Header="Outro length (seconds)" Minimum="5" Maximum="20" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.SeriesOutro, Mode=TwoWay}"
                           ToolTipService.ToolTip="YouTube end-screen cards can be shown over the last 5 to 20 seconds of a video." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Spacing="{StaticResource Gap}" Width="420">
            <Border CornerRadius="6" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                <MediaPlayerElement x:Name="IntroPlayer" AreTransportControlsEnabled="True" Stretch="Uniform" Height="236" AutomationProperties.Name="Intro preview" />
            </Border>
            <Button x:Name="PreviewIntroButton" HorizontalAlignment="Stretch" MinHeight="44" Command="{x:Bind ViewModel.PreviewIntroCommand}"
                    ToolTipService.ToolTip="Draws a short draft of the intro with the settings on the left. It is made on this computer and costs nothing.">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                    <SymbolIcon Symbol="Play" />
                    <TextBlock Text="Show the intro" />
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.PreviewIntroCommand.IsRunning, Mode=OneWay}" />
            <TextBlock Style="{StaticResource QuietText}" TextWrapping="Wrap"
                       Text="Every episode opens with this intro and ends with an outro of the same look, which leaves room on the right for YouTube's end-screen cards. New episodes start in the look set here; Use the series look gives it to an episode made before." />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </Grid>
</ContentDialog>
