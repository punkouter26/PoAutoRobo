<UserControl
    x:Class="PoAutoRobo.App.Views.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:app="using:PoAutoRobo.App"
    Unloaded="OnUnloaded">
    <!-- J, K and L, and comma and full stop, work wherever the keyboard is in the preview -->
    <Grid RowSpacing="8" KeyDown="OnTransportKey">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The preview takes whatever room the window gives it, kept at 16:9. Captions are drawn live on top, so style changes show without re-rendering. -->
        <Grid x:Name="Stage" SizeChanged="OnStageSized">
            <Grid x:Name="Screen" Width="640" Height="360" CornerRadius="4" Background="Black" Tapped="OnScreenTapped">
                <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" Stretch="Uniform" />
                <canvas:CanvasControl x:Name="Overlay" Draw="OnDrawCaption" IsHitTestVisible="False" />
                <!-- Until there is a preview, the empty screen offers the one thing to do here -->
                <Button x:Name="BuildHereButton" Content="Build preview" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnBuildPreview"
                        ToolTipService.ToolTip="Make a quick low-resolution version of the whole episode to watch here, before rendering it at full size. Any clip whose voice is not yet recorded is recorded first." />
                <!-- The captions are set here, on the picture they are drawn over, and show each change as it is made -->
                <Button x:Name="CaptionsButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="10,4" MinHeight="36" Content="Aa" FontWeight="SemiBold"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" AutomationProperties.Name="Caption style"
                        ToolTipService.ToolTip="How the burned-in captions look: their style, size, outline and colour. The words on the preview change as you do.">
                    <Button.Flyout>
                        <Flyout Placement="LeftEdgeAlignedTop">
                            <StackPanel Width="300" Spacing="10">
                                <TextBlock Text="Captions" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="CaptionPresetBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Caption style" ToolTipService.ToolTip="How the burned-in captions look: a word lit as it is spoken, a two-line block, plain subtitles or a comic banner. The preview shows each one as you pick it."
                                          ItemsSource="{x:Bind ViewModel.CaptionChoices}" SelectedIndex="{x:Bind ViewModel.CaptionPresetIndex, Mode=TwoWay}" />
                                <Slider Header="Font size" Visibility="{x:Bind app:Ui.ShowEither(ViewModel.Advanced, ViewModel.CaptionsTuned), Mode=OneWay}" Minimum="32" Maximum="96" StepFrequency="2" Value="{x:Bind ViewModel.CaptionFontSize, Mode=TwoWay}"
                                        ToolTipService.ToolTip="How big the caption words are. Drag it and watch the preview; bigger is easier to read on a phone." />
                                <Slider Header="Outline" Visibility="{x:Bind app:Ui.ShowEither(ViewModel.Advanced, ViewModel.CaptionsTuned), Mode=OneWay}" Minimum="0" Maximum="10" StepFrequency="1" Value="{x:Bind ViewModel.CaptionStroke, Mode=TwoWay}"
                                        ToolTipService.ToolTip="How thick the edge drawn round each letter is, which keeps the words readable over a busy picture. 0 for none." />
                                <TextBlock Text="Accent colour" ToolTipService.ToolTip="The colour of the word being spoken, or of the banner behind the words. Click a swatch below, or open Any colour to choose your own." />
                                <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal" MaximumRowsOrColumns="8" ItemWidth="36" ItemHeight="36" />
                                <Expander Header="Any colour" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          ToolTipService.ToolTip="Choose an accent colour not among the swatches: pick it from the colour square, or type its hex code, such as your channel's own colour.">
                                    <ColorPicker IsAlphaEnabled="False" IsMoreButtonVisible="False" IsColorSliderVisible="True" IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="True" Color="{x:Bind ViewModel.CaptionAccent, Mode=TwoWay}" />
                                </Expander>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Grid>

        <!-- The narration's waveform with a mark where each clip starts; click anywhere on it to jump there -->
        <canvas:CanvasControl x:Name="Wave" Grid.Row="1" Draw="OnDrawWave" PointerPressed="OnWavePressed" AutomationProperties.Name="Waveform and clip markers"
                              IsTabStop="True" UseSystemFocusVisuals="True" KeyDown="OnWaveKey"
                              ToolTipService.ToolTip="The narration, with a mark where each clip starts. Click to jump to that point. With the keyboard: Space plays or pauses and the arrows step five seconds; L plays, and pressed again plays faster; K pauses; J steps back; comma and full stop step one frame while paused." />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Width="44" Height="44" CornerRadius="22" Padding="0" Click="OnPlayPause"
                    AutomationProperties.Name="Play or pause" IsEnabled="False" ToolTipService.ToolTip="Play or pause the preview. Clicking the picture does the same, and so do L (play) and K (pause).">
                <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
            </Button>
            <Slider x:Name="Scrubber" Grid.Column="1" ToolTipService.ToolTip="Where you are in the preview. Drag it to move to any point." VerticalAlignment="Center" Minimum="0" Maximum="1" StepFrequency="0.1"
                    IsEnabled="False" IsThumbToolTipEnabled="False" ValueChanged="OnScrub" AutomationProperties.Name="Position" />
            <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="How far into the preview you are, and how long the whole preview runs." />
            <!-- Once there is a preview, this is how it is made again after the clips change -->
            <Button x:Name="RebuildButton" Grid.Column="3" Content="Rebuild" MinHeight="44" Visibility="Collapsed" Click="OnBuildPreview"
                    ToolTipService.ToolTip="Build the preview again, to see changes made to the clips since. Caption changes show without rebuilding." />
        </Grid>
    </Grid>
</UserControl>
