<UserControl
    x:Class="PoAutoRobo.App.Views.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Unloaded="OnUnloaded">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The preview takes whatever room the window gives it, kept at 16:9. Captions are drawn live on top, so style changes show without re-rendering. -->
        <Grid x:Name="Stage" SizeChanged="OnStageSized">
            <Grid x:Name="Screen" Width="640" Height="360" CornerRadius="4" Background="Black">
                <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" Stretch="Uniform" />
                <canvas:CanvasControl x:Name="Overlay" Draw="OnDrawCaption" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- The narration's waveform with a mark where each clip starts; click anywhere on it to jump there -->
        <canvas:CanvasControl x:Name="Wave" Grid.Row="1" Draw="OnDrawWave" PointerPressed="OnWavePressed" AutomationProperties.Name="Waveform and clip markers"
                              ToolTipService.ToolTip="The narration, with a mark where each clip starts. Click to jump to that point." />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Width="44" Height="44" CornerRadius="22" Padding="0" Click="OnPlayPause"
                    AutomationProperties.Name="Play or pause" IsEnabled="False" ToolTipService.ToolTip="Play or pause the preview.">
                <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
            </Button>
            <Slider x:Name="Scrubber" Grid.Column="1" ToolTipService.ToolTip="Drag to move through the preview." VerticalAlignment="Center" Minimum="0" Maximum="1" StepFrequency="0.1"
                    IsEnabled="False" IsThumbToolTipEnabled="False" ValueChanged="OnScrub" AutomationProperties.Name="Position" />
            <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
