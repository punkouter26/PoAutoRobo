<UserControl
    x:Class="PoAutoRobo.App.Views.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Unloaded="OnUnloaded">
    <Grid Padding="16,12" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Preview with captions drawn live on top, so style changes show without re-rendering -->
        <Grid Width="320" Height="180" CornerRadius="4" Background="Black">
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" Stretch="Uniform" />
            <canvas:CanvasControl x:Name="Overlay" Draw="OnDrawCaption" IsHitTestVisible="False" />
        </Grid>

        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Width="44" Height="44" CornerRadius="22" Padding="0" Click="OnPlayPause"
                        AutomationProperties.Name="Play or pause" IsEnabled="False">
                    <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
                </Button>
                <Slider x:Name="Scrubber" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1" StepFrequency="0.1"
                        IsEnabled="False" IsThumbToolTipEnabled="False" ValueChanged="OnScrub" AutomationProperties.Name="Position" />
                <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00 / 0:00" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="PreviewButton" Content="Build preview" Command="{x:Bind ViewModel.BuildPreviewCommand}" />
                <Button Content="Cancel" Command="{x:Bind ViewModel.BuildPreviewCancelCommand}"
                        Visibility="{x:Bind ViewModel.BuildPreviewCommand.IsRunning, Mode=OneWay}" />
                <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
