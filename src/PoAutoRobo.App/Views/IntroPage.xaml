<UserControl
    x:Class="PoAutoRobo.App.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PoAutoRobo.App"
    xmlns:local="using:PoAutoRobo.App.Views"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:PoAutoRobo.App.ViewModels">
    <!-- Left: what the intro is made of, and the rest of what every episode shares, saved as it is changed. Right: the
         intro or outro itself, drawn on request. Set once, it opens every episode the same way: only the episode's
         number and title change. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="{StaticResource IntroColumn}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource Gap}">
                <TextBox x:Name="ChannelBox" Header="Channel name" PlaceholderText="Teaching the R1" Text="{x:Bind ViewModel.SeriesChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                         ToolTipService.ToolTip="Your channel's name, shown large in every intro and outro. Type it once; it is saved as you go. Without one, episodes are exported with no intro or outro." />
                <TextBox x:Name="TaglineBox" Header="Tagline" PlaceholderText="One skill at a time" Text="{x:Bind ViewModel.SeriesTagline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                         ToolTipService.ToolTip="A short line shown under the channel name in the intro. Optional: leave it empty to show the name alone." />

                <TextBlock Text="Look" Style="{StaticResource SectionHeading}" />
                <!-- Ready-made looks: a colour and a layout each, drawn as a small sketch of the intro -->
                <ItemsControl x:Name="StartList" ItemsSource="{x:Bind vm:MainViewModel.IntroStarts}" IsTabStop="False"
                          Margin="-4,-4,0,0" AutomationProperties.Name="Ready-made looks"
                          ToolTipService.ToolTip="Ready-made looks to start from. Click one to give the intro its colour and layout, then change either below. Your name, logo, mascot and sting stay as they are.">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="126" ItemHeight="100" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IntroStart">
                            <Button Tag="{x:Bind}" Click="OnStart" Padding="4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind Name}"
                                    ToolTipService.ToolTip="Click to give the intro this colour and layout. The picture on the right shows it a moment later.">
                                <StackPanel Width="116" Spacing="4">
                                    <Grid Height="66" CornerRadius="6">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#101828" />
                                                <GradientStop Offset="1" Color="{x:Bind Colour}" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Border Height="22" VerticalAlignment="Bottom" Margin="0,0,0,5" Background="#73000000" Visibility="{x:Bind local:IntroPage.Band(Layout)}" />
                                        <Border Width="{x:Bind local:IntroPage.MascotWidth(Layout)}" Height="{x:Bind local:IntroPage.MascotHeight(Layout)}" CornerRadius="4" Background="#D9FFFFFF"
                                                HorizontalAlignment="{x:Bind local:IntroPage.MascotAcross(Layout)}" VerticalAlignment="{x:Bind local:IntroPage.MascotDown(Layout)}" Margin="8,6" />
                                        <StackPanel Spacing="3" Margin="8" HorizontalAlignment="{x:Bind local:IntroPage.WordsAcross(Layout)}" VerticalAlignment="{x:Bind local:IntroPage.WordsDown(Layout)}">
                                            <Border Width="44" Height="6" CornerRadius="2" Background="White" HorizontalAlignment="{x:Bind local:IntroPage.WordsAcross(Layout)}" />
                                            <Border Width="28" Height="4" CornerRadius="2" Background="#B3FFFFFF" HorizontalAlignment="{x:Bind local:IntroPage.WordsAcross(Layout)}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource QuietText}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="4">
                    <TextBlock Text="Layout" />
                    <controls:Segmented x:Name="LayoutSelector" SelectedIndex="{x:Bind ViewModel.SeriesLayoutIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Layout"
                                        ToolTipService.ToolTip="Where the words and mascot sit in the intro. Side: words left, mascot right. Centre: mascot above, words centred under it. Lower band: words on a dark band across the bottom. The picture on the right shows each one as you pick it.">
                        <controls:SegmentedItem Content="Side" />
                        <controls:SegmentedItem Content="Centre" />
                        <controls:SegmentedItem Content="Lower band" />
                    </controls:Segmented>
                </StackPanel>
                <TextBox x:Name="AccentBox" Header="Accent colour" PlaceholderText="#FFD400" Text="{x:Bind ViewModel.SeriesAccent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"
                         ToolTipService.ToolTip="The series colour, typed as # and six letters or digits, such as #22CC88. It fills the intro and outro background and colours the section straps and captions of new episodes." />

                <TextBlock Text="Pictures" Style="{StaticResource SectionHeading}" />
                <Grid ColumnSpacing="{StaticResource GapSmall}" RowSpacing="{StaticResource GapSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Logo" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SeriesLogoLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="Pick…" Tag="logo" Click="OnPick" ToolTipService.ToolTip="Choose your logo: a PNG, best with a see-through background. It sits in a top corner of the intro and outro. The app keeps its own copy." />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="logo" Click="OnClear" AutomationProperties.Name="Use the app's logo" ToolTipService.ToolTip="Go back to the logo the app makes for you: a robot's head in the series colour."><SymbolIcon Symbol="Cancel" /></Button>

                    <TextBlock Grid.Row="1" Text="Mascot" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SeriesMascotLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Pick…" Tag="mascot" Click="OnPick" ToolTipService.ToolTip="Choose a PNG of your mascot, shown beside the words in the intro and outro. Or use the button below for the host you designed." />
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource IconButton}" Tag="mascot" Click="OnClear" AutomationProperties.Name="Use the app's mascot" ToolTipService.ToolTip="Go back to the mascot the app makes for you: a robot standing ready, in the series colour."><SymbolIcon Symbol="Cancel" /></Button>
                </Grid>
                <!-- A logo drawn for the channel, the way the host is: three candidates, one clicked to use -->
                <Grid ColumnSpacing="{StaticResource GapSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MakeLogosButton" Content="Make 3 logos" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.MakeLogoCandidatesCommand}" IsEnabled="{x:Bind ViewModel.PicturesAvailable, Mode=OneWay}"
                            ToolTipService.ToolTip="Draws three logo designs for your channel, from your host when you have one, in the series colour and on nothing so they sit on any background. You are asked first, with the cost; then click the one to use." />
                    <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.MakeLogoCandidatesCancelCommand}" Visibility="{x:Bind ViewModel.MakeLogoCandidatesCommand.IsRunning, Mode=OneWay}"
                            ToolTipService.ToolTip="Stop drawing the logos. Any already drawn are kept, so asking again does not pay for them twice." />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.LogoCandidatesCost, Mode=OneWay}" Style="{StaticResource QuietText}" Margin="0,-6,0,0" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.MakeLogoCandidatesCommand.IsRunning, Mode=OneWay}" />
                <ItemsControl x:Name="LogoList" ItemsSource="{x:Bind ViewModel.LogoCandidates}" IsTabStop="False" AutomationProperties.Name="Logo designs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Tag="{x:Bind}" Click="OnUseLogo" Padding="4" AutomationProperties.Name="A logo design"
                                    ToolTipService.ToolTip="Use this logo. The intro picture shows it a moment later, and the kit keeps its own copy.">
                                <Image Width="68" Height="68" Stretch="Uniform" Source="{x:Bind local:ClipCard.ToImage((x:String))}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The host: the cartoon robot in every episode's pictures, chosen once so the character always looks the same -->
                <StackPanel Spacing="{StaticResource Gap}" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}">
                    <TextBlock Text="Host" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource QuietText}" TextWrapping="Wrap"
                               Text="The cartoon robot that presents every episode. Pick one design and every new picture keeps it, so the character always looks the same." />
                    <Grid ColumnSpacing="{StaticResource GapSmall}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MakeHostsButton" Content="Make 3 hosts" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.MakeHostCandidatesCommand}" IsEnabled="{x:Bind ViewModel.PicturesAvailable, Mode=OneWay}"
                                ToolTipService.ToolTip="Draws three possible designs for the host; click the one to keep. It costs three pictures, the price shown just below. Needs the picture service." />
                        <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.MakeHostCandidatesCancelCommand}" Visibility="{x:Bind ViewModel.MakeHostCandidatesCommand.IsRunning, Mode=OneWay}"
                                ToolTipService.ToolTip="Stop drawing the host designs." />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.HostCandidatesCost, Mode=OneWay}" Style="{StaticResource QuietText}" TextWrapping="Wrap" Margin="0,-6,0,0" />
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.MakeHostCandidatesCommand.IsRunning, Mode=OneWay}" />
                    <ItemsControl x:Name="HostList" ItemsSource="{x:Bind ViewModel.HostCandidates}" IsTabStop="False" AutomationProperties.Name="Host designs">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Tag="{x:Bind}" Click="OnUseHost" Padding="4" AutomationProperties.Name="A host design"
                                        ToolTipService.ToolTip="Keep this design as the host, so every new picture shows the same character. Pictures already made are not changed.">
                                    <Image Width="96" Height="64" Stretch="UniformToFill" Source="{x:Bind local:ClipCard.ToImage((x:String))}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Use my own image…" HorizontalAlignment="Stretch" Click="OnPickOwnHost"
                            ToolTipService.ToolTip="Choose a PNG of your own design to be the host. It is kept straight away for every new picture. Free." />
                    <Button x:Name="HostMascotButton" Content="Use the host design as the mascot" Command="{x:Bind ViewModel.UseHostAsMascotCommand}" HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.HasHostDesign, Mode=OneWay}"
                            ToolTipService.ToolTip="Uses the cartoon robot that presents your episodes as the mascot of the intro and outro. It is already made, so this costs nothing. Greyed out until a host has been chosen just above." />
                </StackPanel>

                <TextBlock Text="Sound" Style="{StaticResource SectionHeading}" />
                <Grid ColumnSpacing="{StaticResource GapSmall}" RowSpacing="{StaticResource GapSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sting" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SeriesStingLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="Pick…" Tag="sting" Click="OnPick" ToolTipService.ToolTip="Choose a few seconds of music for the intro (MP3, WAV, M4A, FLAC or OGG). Anything past five seconds is cut. With none, the app makes one that fits the swarm of light." />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="sting" Click="OnClear" AutomationProperties.Name="Use the app's sting" ToolTipService.ToolTip="Go back to the sting the app makes for you: a robot waking for its lesson, servos turning and data blips quickening into the hit."><SymbolIcon Symbol="Cancel" /></Button>
                    <TextBlock Grid.Row="1" Text="Outro" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SeriesMusicLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Pick…" Tag="music" Click="OnPick"
                            ToolTipService.ToolTip="Use your own music for the outro of every new episode (MP3, WAV, M4A, FLAC or OGG). Music plays only over the intro and outro, never under the clips. Until you choose, the app makes a robot-lab tune. Use music you have the right to publish." />
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource IconButton}" Tag="music" Click="OnClear" AutomationProperties.Name="Use the app's outro music"
                            ToolTipService.ToolTip="Go back to the app's own outro tune: a robot lab winding down, soft chords, bright blips and a steady pulse."><SymbolIcon Symbol="Cancel" /></Button>
                </Grid>

                <!-- Advanced: fifteen seconds suits YouTube's end screen. Shown anyway while it is set to another length. -->
                <StackPanel Spacing="{StaticResource Gap}" Visibility="{x:Bind app:Ui.ShowEither(ViewModel.Advanced, ViewModel.OutroTuned), Mode=OneWay}">
                    <TextBlock Text="Outro" Style="{StaticResource SectionHeading}" />
                    <NumberBox x:Name="OutroBox" Header="Outro length (seconds)" Minimum="5" Maximum="20" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.SeriesOutro, Mode=TwoWay}"
                               ToolTipService.ToolTip="How long the outro at the end of every episode runs, 5 to 20 seconds; 15 unless changed. YouTube's end-screen cards (subscribe, next video) can be placed over it when you upload. Type a number or use the arrows." />
                </StackPanel>

                <TextBlock Text="New episodes" Style="{StaticResource SectionHeading}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Told as" />
                    <controls:Segmented x:Name="StructureSelector" SelectedIndex="{x:Bind ViewModel.SeriesStructureIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Structure"
                                        ToolTipService.ToolTip="The shape every episode of the series follows, so each lesson is told the same way. Story: goal, try, fail, fix, result, recap. Tutorial: concept, setup, demo, recap. Hook first: the best moment, then how it works.">
                        <controls:SegmentedItem Content="Story" />
                        <controls:SegmentedItem Content="Tutorial" />
                        <controls:SegmentedItem Content="Hook first" />
                    </controls:Segmented>
                    <TextBlock x:Name="BeatsText" Text="{x:Bind ViewModel.StructureBeats, Mode=OneWay}" Style="{StaticResource QuietText}" TextWrapping="Wrap"
                               ToolTipService.ToolTip="The beats in order. Your footage goes in the ones marked with a camera." />
                </StackPanel>
                <ComboBox x:Name="LookBox" Header="Picture style" HorizontalAlignment="Stretch" ItemsSource="{x:Bind vm:MainViewModel.LookChoices}" SelectedIndex="{x:Bind ViewModel.SeriesLookIndex, Mode=TwoWay}"
                          ToolTipService.ToolTip="The art style new episodes' pictures are drawn in: comic book, photograph, flat vector or cinematic. Episodes already made keep theirs; the button below, when it shows, gives it to the open one." />
                <!-- Only while the open episode was made before the look changed -->
                <Button x:Name="SeriesLookButton" Content="Give the open episode this look" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.UseSeriesLookCommand}"
                        Visibility="{x:Bind ViewModel.EpisodeOffSeriesLook, Mode=OneWay}"
                        ToolTipService.ToolTip="The open episode was made before the series' picture style, captions or outro music changed. This gives it the series look, as one step Undo reverses. Pictures already drawn are not redrawn, and nothing is paid for." />
            </StackPanel>
        </ScrollViewer>

        <!-- The intro or the outro as it will play, as large as the room allows, with the buttons that draw them below -->
        <Grid Grid.Column="1" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource QuietText}"
                       Text="The picture below follows your changes as you make them. The intro runs about five seconds, the same at the start of every episode: the swarm of light, your logo and mascot, the channel name and tagline, then the episode's number and title, over the sting. The outro at the end has the same look, with room on the right for YouTube's end-screen cards." />
            <!-- A still of the intro as the settings stand, redrawn a moment after each change; the buttons below play it in full -->
            <Grid Grid.Row="1" CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                <Image x:Name="StillImage" Stretch="Uniform" AutomationProperties.Name="The intro as it stands"
                       ToolTipService.ToolTip="The intro as it will look once its words are in, redrawn a moment after each change on the left. Press Show the intro to watch it move, with its sound." />
                <Border x:Name="StillBadge" Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="StillBadgeText" Style="{StaticResource QuietText}" Text="Still · follows your changes" />
                </Border>
                <MediaPlayerElement x:Name="IntroPlayer" AreTransportControlsEnabled="True" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Intro or outro preview"
                                    ToolTipService.ToolTip="The intro or outro last drawn. Use the controls along its foot to play it again, pause it or watch it full screen. Change anything on the left to go back to the still." />
            </Grid>
            <StackPanel Grid.Row="2" Spacing="{StaticResource GapSmall}">
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.PreviewIntroCommand.IsRunning, Mode=OneWay}" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.PreviewOutroCommand.IsRunning, Mode=OneWay}" />
                <Grid ColumnSpacing="{StaticResource GapSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviewIntroButton" HorizontalAlignment="Stretch" MinHeight="44" Command="{x:Bind ViewModel.PreviewIntroCommand}"
                            Style="{x:Bind app:Ui.Primary(ViewModel.ShowIntroIsNext), Mode=OneWay}"
                            ToolTipService.ToolTip="Plays the intro in full, moving and with its sound: the swarm of light gathering into the picture above, for the next episode's number. Takes a few seconds to draw; made on this computer, it costs nothing.">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock Text="Show the intro" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PreviewOutroButton" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="44" Command="{x:Bind ViewModel.PreviewOutroCommand}"
                            ToolTipService.ToolTip="Draws the outro that ends every episode, at its full length, and plays it. The two faint frames on the right are where YouTube's end-screen cards go. Made on this computer; it costs nothing.">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock Text="Show the outro" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
