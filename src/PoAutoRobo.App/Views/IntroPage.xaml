<UserControl
    x:Class="PoAutoRobo.App.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:PoAutoRobo.App"
    xmlns:vm="using:PoAutoRobo.App.ViewModels">
    <!-- Left: what the intro is made of, saved as it is changed. Right: the intro itself, drawn on request. Set once,
         it opens every episode the same way: only the episode's number and title change. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="{StaticResource IntroColumn}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource Gap}">
                <TextBox x:Name="ChannelBox" Header="Channel name" PlaceholderText="Teaching the R1" Text="{x:Bind ViewModel.SeriesChannel, Mode=TwoWay}" MaxLength="60"
                         ToolTipService.ToolTip="Shown large in every intro and outro. Without one, episodes are exported with no intro or outro." />
                <TextBox x:Name="TaglineBox" Header="Tagline" PlaceholderText="One skill at a time" Text="{x:Bind ViewModel.SeriesTagline, Mode=TwoWay}" MaxLength="80" />

                <TextBlock Text="Pictures" Style="{StaticResource SectionHeading}" />
                <Grid ColumnSpacing="{StaticResource GapSmall}" RowSpacing="{StaticResource GapSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Logo" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SeriesLogoLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="Pick…" Tag="logo" Click="OnPick" ToolTipService.ToolTip="A PNG, best with a see-through background. Shown in the corner of the intro and outro." />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="logo" Click="OnClear" AutomationProperties.Name="No logo"><SymbolIcon Symbol="Cancel" /></Button>

                    <TextBlock Grid.Row="1" Text="Mascot" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SeriesMascotLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Pick…" Tag="mascot" Click="OnPick" ToolTipService.ToolTip="A PNG of the mascot, shown beside the words in the intro and outro." />
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource IconButton}" Tag="mascot" Click="OnClear" AutomationProperties.Name="No mascot"><SymbolIcon Symbol="Cancel" /></Button>
                </Grid>
                <Button x:Name="HostMascotButton" Content="Use the host design as the mascot" Command="{x:Bind ViewModel.UseHostAsMascotCommand}" HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind vm:MainViewModel.HasHostDesign}"
                        ToolTipService.ToolTip="The cartoon robot chosen under Series and look, on its Host tab. It is made once, so using it here costs nothing." />

                <TextBlock Text="Sound" Style="{StaticResource SectionHeading}" />
                <Grid ColumnSpacing="{StaticResource GapSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sting" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SeriesStingLabel, Mode=OneWay}" Style="{StaticResource QuietText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="Pick…" Tag="sting" Click="OnPick" ToolTipService.ToolTip="A few seconds of music for the intro. Anything past five seconds is cut. With none, the app makes one." />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="sting" Click="OnClear" AutomationProperties.Name="No sting"><SymbolIcon Symbol="Cancel" /></Button>
                </Grid>

                <TextBlock Text="Colour and outro" Style="{StaticResource SectionHeading}" />
                <TextBox x:Name="AccentBox" Header="Accent colour" PlaceholderText="#FFD400" Text="{x:Bind ViewModel.SeriesAccent, Mode=TwoWay}" MaxLength="7"
                         ToolTipService.ToolTip="As #RRGGBB. Used for the intro and outro background, the section straps and the captions." />
                <NumberBox x:Name="OutroBox" Header="Outro length (seconds)" Minimum="5" Maximum="20" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.SeriesOutro, Mode=TwoWay}"
                           ToolTipService.ToolTip="YouTube end-screen cards can be shown over the last 5 to 20 seconds of a video." />
            </StackPanel>
        </ScrollViewer>

        <!-- The intro as it will open the next episode, as large as the room allows, with the button that draws it below -->
        <Grid Grid.Column="1" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource Gap}" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource QuietText}"
                       Text="About five seconds, the same at the start of every episode: the swarm of light, your logo and mascot, the channel name and tagline, then the episode's number and title, over the sting. The outro at the end has the same look." />
            <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                <MediaPlayerElement x:Name="IntroPlayer" AreTransportControlsEnabled="True" Stretch="Uniform" AutomationProperties.Name="Intro preview" />
            </Border>
            <StackPanel Grid.Row="2" Spacing="{StaticResource GapSmall}">
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.PreviewIntroCommand.IsRunning, Mode=OneWay}" />
                <Button x:Name="PreviewIntroButton" HorizontalAlignment="Stretch" MinHeight="44" Command="{x:Bind ViewModel.PreviewIntroCommand}"
                        Style="{x:Bind app:Ui.Primary(ViewModel.ShowIntroIsNext), Mode=OneWay}"
                        ToolTipService.ToolTip="Draws the intro with the settings on the left, for the next episode's number. It is made on this computer and costs nothing.">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Show the intro" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
