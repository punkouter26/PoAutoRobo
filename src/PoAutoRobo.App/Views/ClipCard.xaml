<UserControl
    x:Class="PoAutoRobo.App.Views.ClipCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:PoAutoRobo.App.Views">
    <StackPanel Width="248" Spacing="8" Padding="4">
        <Grid Height="140" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
            <Image Source="{x:Bind local:ClipCard.ToImage(Card.ThumbnailPath), Mode=OneWay}" Stretch="UniformToFill" />
            <Border Margin="8" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{x:Bind Card.IsStale, Mode=OneWay}">
                <TextBlock Text="Out of date" Style="{ThemeResource CaptionTextBlockStyle}" />
            </Border>
            <Border Margin="8" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    ToolTipService.ToolTip="This clip&#39;s picture type. Change it in the inspector or with Visual mix.">
                <TextBlock Text="{x:Bind Card.KindText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </Border>
            <Border Margin="8" Padding="6,2" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <TextBlock Text="{x:Bind Card.DurationText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </Border>
        </Grid>
        <TextBlock Text="{x:Bind Card.Heading, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Card.DurationWarning, Mode=OneWay}" Visibility="{x:Bind Card.HasDurationWarning, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        <controls:Segmented SelectedIndex="{x:Bind Card.TierIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Depth of explanation">
            <controls:SegmentedItem Content="A" ToolTipService.ToolTip="Accessible: everyday analogies" />
            <controls:SegmentedItem Content="B" ToolTipService.ToolTip="Applied: developer workflow" />
            <controls:SegmentedItem Content="C" ToolTipService.ToolTip="Advanced: systems engineering" />
        </controls:Segmented>
        <ToggleSwitch ToolTipService.ToolTip="On: the host appears in this clip&#39;s picture. Off: a full-frame diagram, with the host heard but not seen." IsOn="{x:Bind Card.HostVisible, Mode=TwoWay}" OnContent="Host visible" OffContent="Off-screen voiceover"
                      AutomationProperties.Name="Host on screen" />
    </StackPanel>
</UserControl>
