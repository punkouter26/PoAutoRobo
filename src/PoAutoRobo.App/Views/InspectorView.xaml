<UserControl
    x:Class="PoAutoRobo.App.Views.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="16" Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
        <TextBlock x:Name="InspectorHeading" Text="{x:Bind ViewModel.SelectedClip.Heading, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
        <TextBox x:Name="DialogueBox" Header="Dialogue" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="320"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Text="{x:Bind ViewModel.DraftDialogue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 LostFocus="OnDialogueLostFocus" />
        <TextBlock x:Name="DraftStatsText" Text="{x:Bind ViewModel.DraftStats, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar IsOpen="{x:Bind ViewModel.SelectedClip.IsStale, Mode=OneWay}" IsClosable="False" Severity="Warning"
                 Title="Picture out of date" Message="The dialogue now describes something different. Regenerate the picture when you are ready." />
        <Border Padding="10,6" CornerRadius="12" HorizontalAlignment="Left" Background="{ThemeResource ControlFillColorSecondaryBrush}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Pose:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run Text="{x:Bind ViewModel.SelectedClip.Pose, Mode=OneWay}" />
            </TextBlock>
        </Border>
        <Button x:Name="AuditionButton" Content="Audition audio" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AuditionCommand}" />
        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.AuditionCommand.IsRunning, Mode=OneWay}" />
    </StackPanel>
</UserControl>
