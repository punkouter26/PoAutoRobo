<UserControl
    x:Class="PoAutoRobo.App.Views.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <TextBlock x:Name="InspectorHeading" Text="{x:Bind ViewModel.SelectedClip.Heading, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />

            <!-- Script step: the words and the voice -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsScriptStep, Mode=OneWay}">
                <TextBox x:Name="DialogueBox" ToolTipService.ToolTip="What the host says in this clip. Edit freely; the voice is re-recorded when you click away." Header="Dialogue"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Text="{x:Bind ViewModel.DraftDialogue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         LostFocus="OnDialogueLostFocus" />
                <TextBlock x:Name="DraftStatsText" Text="{x:Bind ViewModel.DraftStats, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="AuditionButton" ToolTipService.ToolTip="Hear this clip in the host&#39;s voice before building the video." Content="Audition audio"
                        HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AuditionCommand}" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.AuditionCommand.IsRunning, Mode=OneWay}" />
            </StackPanel>

            <!-- Pictures step: what this clip shows -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsPicturesStep, Mode=OneWay}">
                <InfoBar IsOpen="{x:Bind ViewModel.SelectedClip.IsStale, Mode=OneWay}" IsClosable="False" Severity="Warning"
                         Title="Picture out of date" Message="The dialogue now describes something different. Generate the picture again when you are ready." />
                <Border ToolTipService.ToolTip="What the host is doing in this clip&#39;s picture, taken from the subject." Padding="10,6" CornerRadius="12" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Pose:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="{x:Bind ViewModel.SelectedClip.Pose, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <ComboBox x:Name="KindBox" ToolTipService.ToolTip="Set this clip&#39;s picture type yourself. A clip set by hand keeps its type when the visual mix changes." Header="Picture type"
                          HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.SelectedClip.CanPickKind, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.SelectedClip.KindIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Still panel" />
                    <ComboBoxItem Content="Panel sequence" />
                    <ComboBoxItem Content="AI video" />
                    <ComboBoxItem Content="Title card" />
                </ComboBox>
                <Button x:Name="GeneratePictureButton" ToolTipService.ToolTip="Draw this one clip&#39;s picture now (a few cents). An identical request reuses the saved picture free." Content="Generate this clip&#39;s picture"
                        HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.GeneratePictureCommand}" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.GeneratePictureCommand.IsRunning, Mode=OneWay}" />

                <!-- The user's own footage: drop a file or pick one; the narration is then fitted to its length -->
                <Grid x:Name="VideoDrop" ToolTipService.ToolTip="Use your own footage for this clip (5 seconds to 2 minutes). The dialogue is rewritten and re-voiced to match its length."
                      AllowDrop="True" DragOver="OnVideoDragOver" Drop="OnVideoDrop" Background="Transparent">
                    <Rectangle Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeDashArray="4,3" RadiusX="6" RadiusY="6" />
                    <StackPanel Padding="16" Spacing="8">
                        <TextBlock Text="Drop your own video here" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="PickVideoButton" Content="Replace with my video" HorizontalAlignment="Stretch" Click="OnPickVideo" />
                    </StackPanel>
                </Grid>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.AttachVideoCommand.IsRunning, Mode=OneWay}" />
                <TextBlock x:Name="FitMessageText" Text="{x:Bind ViewModel.FitMessage, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Use a generated picture instead" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RemoveVideoCommand}"
                        Visibility="{x:Bind ViewModel.SelectedClip.HasUserVideo, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
