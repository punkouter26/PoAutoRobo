<winex:WindowEx
    x:Class="PoAutoRobo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:PoAutoRobo.App.ViewModels"
    xmlns:views="using:PoAutoRobo.App.Views"
    xmlns:local="using:PoAutoRobo.App"
    Title="PoAutoRobo"
    PersistenceId="Main"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="600">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Five steps: Intro, Lesson, Clips, Preview, Publish. One page shows at a time; the selector in the header moves
         between them, and the bar under it says what the step asks for. -->

    <Grid x:Name="Root">
        <!-- In a small window the column beside each page gives some of its width back to the page. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- The header's buttons keep their signs and lose their words, which are in their tooltips, so the episode's title has room. -->
                        <Setter Target="Commands.DefaultLabelPosition" Value="Collapsed" />
                        <Setter Target="MakeLabel.Visibility" Value="Collapsed" />
                        <Setter Target="InspectorColumn.Width" Value="300" />
                        <Setter Target="PreviewColumn.Width" Value="240" />
                        <Setter Target="PublishColumn.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnStepShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnStepShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnStepShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnStepShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnStepShortcut" />
            <!-- The clip loop from the keyboard: write, draw, copy, listen. Each does what its button does, when its button could. -->
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="OnCommandShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="G" Invoked="OnCommandShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="OnCommandShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnCommandShortcut" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="P" Invoked="OnCommandShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: what you are making and every action for the episode; below them, where you are in the five steps
             and what this step asks for -->
        <Grid Padding="{StaticResource HeaderPadding}" ColumnSpacing="{StaticResource GapSmall}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="EpisodeTitleText" Text="{x:Bind ViewModel.EpisodeTitle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.EpisodeTitle, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <!-- Written by the window, so the running time and cost roll to a new value instead of jumping. -->
                <TextBlock x:Name="MetaText" Style="{StaticResource QuietText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="Clips, length of the finished video (measured once a clip's voice is recorded, estimated from the word count until then), what the episode has cost, and how much the script and voice services have been used. Settings has the full breakdown." />
            </StackPanel>

            <CommandBar x:Name="Commands" Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center" AutomationProperties.Name="Episode actions">
                <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" LabelPosition="Collapsed" Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo the last change to the episode (Ctrl+Z)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" LabelPosition="Collapsed" Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo the change you undid (Ctrl+Y)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <!-- One button for making the episode: a click does the next thing still to do (record the voices, draw the
                     pictures, or build a draft), and its menu has each job on its own and the finished video. Each asks
                     first and shows the cost. -->
                <AppBarElementContainer x:Name="MakeContainer" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasEpisode, Mode=OneWay}">
                    <SplitButton x:Name="MakeButton" Click="OnMakeNext" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsWorking), Mode=OneWay}" Margin="4,0"
                                 AutomationProperties.Name="{x:Bind ViewModel.MakeNextLabel, Mode=OneWay}"
                                 ToolTipService.ToolTip="Do the next thing still to make: record the voices, then draw the pictures, then build a draft to watch. The menu has each job on its own. You are shown the cost before anything is paid for.">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                            <SymbolIcon Symbol="Play" />
                            <TextBlock x:Name="MakeLabel" Text="{x:Bind ViewModel.MakeNextLabel, Mode=OneWay}" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="NarrateAllItem" Text="Record voices" Command="{x:Bind ViewModel.NarrateAllCommand}"
                                                ToolTipService.ToolTip="Record every clip's voice now. Each card and the running time then show the real length, not an estimate, and previews build faster.">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Microphone" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="GenerateAllItem" Text="Generate pictures" Command="{x:Bind ViewModel.GenerateAllCommand}"
                                                ToolTipService.ToolTip="Draw a picture for every clip that needs one. You are shown the count and cost first; pictures you already have are reused free.">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Pictures" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MakeDraftItem" Text="All of it: a draft to watch" Command="{x:Bind ViewModel.MakeDraftCommand}"
                                                ToolTipService.ToolTip="Every voice and picture still wanted, then the quick preview on the Preview step, to watch through before anything is rendered at full size.">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="View" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MakeMasterItem" Text="All of it: the finished video" Command="{x:Bind ViewModel.MakeAllCommand}" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}"
                                                ToolTipService.ToolTip="Every voice and picture still wanted, then the master video at the size chosen on the Publish step, with everything to upload beside it. It never spends more than the cost it shows.">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Video" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </AppBarElementContainer>
                <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Settings" LabelPosition="Collapsed" Click="OnSettings"
                              ToolTipService.ToolTip="Sounds, picture quality, the monthly budget and what has been spent, effects, advanced controls, and which services are on." />
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="SeriesButton" Label="Series and look…" Click="OnSeries"
                                  ToolTipService.ToolTip="The music and look new episodes start with; the host who presents every episode; and this episode's look and mix of pictures. The intro and outro have their own step." />
                    <AppBarButton x:Name="ReviewItem" Label="Have an editor read the script" Command="{x:Bind ViewModel.ReviewScriptCommand}" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}"
                                  ToolTipService.ToolTip="Reads the whole script for weak openings and clips that repeat one another, and marks the cards worth changing. Done once by itself when a script is written." />
                    <AppBarSeparator />
                    <AppBarButton x:Name="RenameEpisodeItem" Label="Rename episode…" Command="{x:Bind ViewModel.RenameEpisodeCommand}" />
                    <AppBarButton x:Name="CleanMediaItem" Label="Remove unused media…" Command="{x:Bind ViewModel.CleanMediaCommand}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <!-- The steps; then what this one asks for, each ticked off as it is done and the next one lit; and one button:
                 the next thing to do that has no button of its own on the page, or moving on once the step is done -->
            <Grid x:Name="GuideBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,6" ColumnSpacing="{StaticResource GapLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:Segmented x:Name="StepSelector" SelectedIndex="{x:Bind ViewModel.Step, Mode=TwoWay}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Step" ToolTipService.ToolTip="{x:Bind ViewModel.StepHint, Mode=OneWay}">
                    <controls:SegmentedItem Content="1 · Intro" />
                    <controls:SegmentedItem Content="2 · Lesson" />
                    <controls:SegmentedItem Content="3 · Clips" IsEnabled="{x:Bind ViewModel.HasEpisode, Mode=OneWay}" />
                    <controls:SegmentedItem Content="4 · Preview" IsEnabled="{x:Bind ViewModel.HasEpisode, Mode=OneWay}" />
                    <controls:SegmentedItem Content="5 · Publish" IsEnabled="{x:Bind ViewModel.HasEpisode, Mode=OneWay}" />
                </controls:Segmented>
                <ItemsControl x:Name="GuideList" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Guide, Mode=OneWay}" VerticalAlignment="Center" IsTabStop="False"
                              AutomationProperties.Name="What this step asks for" ToolTipService.ToolTip="{x:Bind ViewModel.StepHint, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuideItem">
                            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{x:Bind local:Ui.Faint(Next)}" AutomationProperties.Name="{x:Bind Spoken}">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{x:Bind local:Ui.Lit(Done, Next)}" />
                                <TextBlock Text="{x:Bind Text}" FontSize="13" FontWeight="{x:Bind local:Ui.Strong(Next)}" VerticalAlignment="Center" />
                                <TextBlock Text="optional" Style="{StaticResource QuietText}" VerticalAlignment="Center" Visibility="{x:Bind OptionalLeft}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="GuideButton" Grid.Column="2" Content="{x:Bind ViewModel.GuideActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RunGuideActionCommand}"
                        Visibility="{x:Bind ViewModel.HasGuideAction, Mode=OneWay}" Style="{x:Bind local:Ui.Primary(ViewModel.GuideActionIsNext), Mode=OneWay}"
                        ToolTipService.ToolTip="The next thing this step needs, or the next step once this one is done. Anything that costs money asks first." />
            </Grid>
        </Grid>

        <!-- The pages. Each slides in as it is shown. -->
        <Grid Grid.Row="1">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- Step 1 · Intro: set once for the series -->
            <views:IntroPage x:Name="Intro" ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.ShowIntro, Mode=OneWay}" />

            <!-- Step 2 · Lesson -->
            <views:LessonPage x:Name="Lesson" ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.ShowTopic, Mode=OneWay}" />

            <!-- Step 3 · Clips: the deck, with the selected clip's words and picture beside it, and the clips laid end to end below -->
            <Grid x:Name="DeckPage" Visibility="{x:Bind ViewModel.ShowDeck, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="{StaticResource InspectorColumn}" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- A slow cloud of light behind the deck, with Effects on; the cards' frosted glass blurs it -->
                    <views:NebulaBackdrop x:Name="DeckBackdrop" Grid.RowSpan="2" />
                    <GridView x:Name="ClipDeck" Padding="{StaticResource DeckPadding}" ItemsSource="{x:Bind ViewModel.Clips}"
                              SelectedItem="{x:Bind ViewModel.SelectedClip, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Clips in running order"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True" ContainerContentChanging="OnCardShown" SelectionChanged="OnCardSelected" KeyDown="OnDeckKey">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipViewModel">
                                <views:ClipCard x:Name="CardRoot" Card="{x:Bind}" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <!-- The episode end to end against the series' three to five minutes: pick a clip, or drag it along to move it -->
                    <views:ClipStrip x:Name="Strip" Grid.Row="1" Margin="16,0,16,10" ViewModel="{x:Bind ViewModel}"
                                     ToolTipService.ToolTip="The clips end to end, each as wide as it runs, against the series' three to five minutes (the green band). Click one to pick it, drag it along to move it; with the keyboard, the arrows pick and Ctrl with the arrows moves." />
                </Grid>
                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <views:InspectorView x:Name="Inspector" ViewModel="{x:Bind ViewModel}" />
                </Border>

                <!-- While the script is written: placeholder cards in the shape of what is coming, each taking its clip's title as it arrives -->
                <Grid Grid.ColumnSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay}">
                    <GridView x:Name="Skeleton" Padding="{StaticResource DeckPadding}" ItemsSource="{x:Bind ViewModel.Skeletons, Mode=OneWay}" SelectionMode="None" IsHitTestVisible="False" IsTabStop="False"
                              AutomationProperties.AccessibilityView="Raw">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Width="{StaticResource CardWidth}" Spacing="{StaticResource GapSmall}" Padding="4">
                                    <Border Height="{StaticResource CardPictureHeight}" CornerRadius="4" Background="{StaticResource ShimmerBrush}" />
                                    <Border Height="14" Width="150" CornerRadius="4" HorizontalAlignment="Left" Background="{StaticResource ShimmerBrush}"
                                            Visibility="{x:Bind local:Ui.HideText((x:String))}" />
                                    <TextBlock Text="{x:Bind}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind local:Ui.ShowText((x:String))}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Grid>

            <!-- Step 4 · Preview: the preview takes the room there is, with its captions set on it; the music sits beside it -->
            <Grid x:Name="PreviewPage" Padding="{StaticResource PagePadding}" ColumnSpacing="{StaticResource GapLarge}" Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Step, 3), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="{StaticResource ExportColumn}" />
                </Grid.ColumnDefinitions>
                <views:TimelineView ViewModel="{x:Bind ViewModel}" />
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Captions" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource QuietText}" Text="Set on the preview itself: Aa, in its top corner. The words show the new style as you change it." />

                        <TextBlock Text="Music" Style="{StaticResource SectionHeading}" />
                        <Grid ColumnSpacing="{StaticResource GapSmall}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MusicButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="44" Click="OnPickMusic"
                                    ToolTipService.ToolTip="Choose a music file to play quietly under the narration. It repeats to the video's length and dips whenever the voice speaks. Use music you have the right to publish.">
                                <TextBlock Text="{x:Bind ViewModel.MusicLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button x:Name="RemoveMusicButton" Grid.Column="1" Style="{StaticResource IconButton}" Command="{x:Bind ViewModel.RemoveMusicCommand}" Visibility="{x:Bind ViewModel.HasMusic, Mode=OneWay}"
                                    AutomationProperties.Name="Remove the music" ToolTipService.ToolTip="Remove the music">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource QuietText}" Text="A change to the music, or to a clip, shows in the next preview." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Step 5 · Publish: the teasers, ten-second upright cuts for other sites, as cards; the finished videos beside them -->
            <Grid x:Name="PublishPage" Padding="{StaticResource PagePadding}" ColumnSpacing="{StaticResource GapLarge}" Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Step, 4), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PublishColumn" Width="{StaticResource ExportColumn}" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="{StaticResource Gap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="{StaticResource GapSmall}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Teasers" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="SuggestTeasersButton" Grid.Column="1" Content="Suggest teasers" Command="{x:Bind ViewModel.SuggestTeasersCommand}"
                                ToolTipService.ToolTip="Three ten-second upright cuts of this episode for other video sites, each a hook over one to three moments. One quick request to the script service." />
                        <Button x:Name="RenderTeasersButton" Grid.Column="2" Content="{x:Bind ViewModel.RenderTeasersLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RenderTeasersCommand}" Visibility="{x:Bind ViewModel.HasTeasers, Mode=OneWay}"
                                ToolTipService.ToolTip="Builds each kept teaser as a 1080 by 1920 video in the episode's export folder, from the clips already made. Nothing new is paid for." />
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource QuietText}"
                               Text="Optional: three ten-second upright cuts of this episode for other video sites. Change a hook or a moment, untick the ones you do not want, then render the rest." />
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                  VerticalAlignment="Top" Visibility="{x:Bind ViewModel.HasTeasers, Mode=OneWay}">
                            <ItemsControl x:Name="TeaserCardList" ItemsSource="{x:Bind ViewModel.TeaserCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TeaserViewModel">
                                        <Border Width="{StaticResource TeaserCardWidth}" CornerRadius="10" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Upright, as on a phone: the opening clip's picture cropped to the frame, with the hook across its top as the teaser shows it -->
                                                <Grid Width="99" Height="176" CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind views:ClipCard.ToImage(Poster), Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                                    <Border VerticalAlignment="Top" Padding="6,8,6,14" AutomationProperties.AccessibilityView="Raw">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Offset="0" Color="#B0000000" />
                                                                <GradientStop Offset="1" Color="#00000000" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <TextBlock Text="{x:Bind Hook, Mode=OneWay}" Foreground="White" FontSize="11" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <Button Style="{StaticResource PlayOverPicture}" Command="{x:Bind WatchCommand}" AutomationProperties.Name="Watch this teaser"
                                                            ToolTipService.ToolTip="Watch this teaser as it stands, small and quick, before rendering it. Costs nothing.">
                                                        <SymbolIcon Symbol="Play" />
                                                    </Button>
                                                    <Grid Background="{ThemeResource SmokeFillColorDefaultBrush}" Visibility="{x:Bind IsBusy, Mode=OneWay}">
                                                        <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="32" Height="32" />
                                                    </Grid>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBox Text="{x:Bind Hook, Mode=TwoWay}" MaxLength="80" TextWrapping="Wrap" PlaceholderText="Hook" AutomationProperties.Name="Hook"
                                                             ToolTipService.ToolTip="Shown across the top of the teaser. Eight words at most; any more are left off." />
                                                    <!-- Each moment: the clip it is cut from, and where in that clip, dragged along the clip's length -->
                                                    <ItemsControl ItemsSource="{x:Bind Moments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MomentViewModel">
                                                                <StackPanel Margin="0,0,0,4">
                                                                    <ComboBox ItemsSource="{x:Bind ClipChoices}" SelectedIndex="{x:Bind ClipIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Clip" />
                                                                    <Grid ColumnSpacing="6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <views:MomentStrip Maximum="{x:Bind LatestStart, Mode=OneWay}" Length="{x:Bind Length}" Value="{x:Bind Start, Mode=TwoWay}"
                                                                                           AutomationProperties.Name="Starts at, in seconds"
                                                                                           ToolTipService.ToolTip="The clip from start to end, and the part this moment uses. Drag it along, or use the arrows, to choose where it starts." />
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind LengthText}" Style="{StaticResource QuietText}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                                                        <CheckBox Content="Fill" MinWidth="0" IsChecked="{x:Bind Fill, Mode=TwoWay}"
                                                                  ToolTipService.ToolTip="Crop the picture to fill the upright frame, instead of showing it whole over a blurred copy of itself. Fuller, but the sides are lost: watch it to check the robot is still in shot." />
                                                        <CheckBox Content="Keep" MinWidth="0" IsChecked="{x:Bind Keep, Mode=TwoWay}" ToolTipService.ToolTip="Render this teaser with the others" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <!-- Beside the teasers: the master video, with the button that makes it always in view at the foot -->
                <Grid Grid.Column="1" RowSpacing="{StaticResource Gap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Finished video" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource QuietText}"
                                       Text="The whole episode at full size, wrapped in the intro and outro, with a chapter list, subtitles, a thumbnail and an upload description beside it." />
                            <ComboBox x:Name="ExportPresetBox" Visibility="{x:Bind ViewModel.Advanced, Mode=OneWay}" ToolTipService.ToolTip="Size and smoothness of the master video. 4K and 60 fps take much longer to render." HorizontalAlignment="Stretch" AutomationProperties.Name="Export quality"
                                      ItemsSource="{x:Bind ViewModel.ExportChoices}" SelectedIndex="{x:Bind ViewModel.ExportPresetIndex, Mode=TwoWay}" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Spacing="{StaticResource GapSmall}">
                        <!-- The thing this step is for, so the one lit button on the page -->
                        <Button x:Name="RenderButton" HorizontalAlignment="Stretch" MinHeight="44" Content="Render master video" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.RenderCommand}"
                                ToolTipService.ToolTip="Build the finished video file with voice, pictures and captions, plus a chapter list, subtitles, a thumbnail and an upload description. A full episode can take several minutes the first time; clips that have not changed since the last render are not drawn again." />
                        <Button x:Name="ShowFilesButton" HorizontalAlignment="Stretch" MinHeight="44" Content="Show the finished files" Command="{x:Bind ViewModel.ShowExportCommand}" Visibility="{x:Bind ViewModel.HasExport, Mode=OneWay}"
                                ToolTipService.ToolTip="Open the folder holding the finished video and everything made to upload with it." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- What the app is doing and what it has to say, floating over the foot of the page so nothing moves when a job
             starts or ends: the one long job in progress, then the outcome of the last action. -->
        <StackPanel x:Name="Dock" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="{StaticResource DockWidth}" Margin="16,0,16,16" Spacing="{StaticResource GapSmall}">
            <!-- The one long job in progress: what it is, the exact step, how far, how long, and a way to stop it -->
            <Grid x:Name="ActivityPanel" Padding="16,12" ColumnSpacing="{StaticResource GapLarge}" CornerRadius="10" Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay}"
                  Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock x:Name="ActivityTitleText" Text="{x:Bind ViewModel.ActivityTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ActivityTimeText" Text="{x:Bind ViewModel.ActivityTime, Mode=OneWay}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource Gap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="RenderProgressBar" Maximum="100" Height="8" VerticalAlignment="Center" Value="{x:Bind ViewModel.ActivityPercent, Mode=OneWay}" />
                        <!-- Counted up by the window, so the figure rolls to its new value instead of jumping. -->
                        <TextBlock x:Name="ActivityPercentText" Grid.Column="1" Text="0%" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="ActivityDetailText" Text="{x:Bind ViewModel.ActivityDetail, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ActivityDetail, Mode=OneWay}"
                               Style="{StaticResource QuietText}" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    <!-- While clips are drawn, each develops here like a print in the tray -->
                    <views:DarkroomStrip x:Name="Darkroom" Visibility="Collapsed" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="CancelActivityButton" Grid.Column="1" Content="Cancel" MinWidth="96" MinHeight="44" VerticalAlignment="Center" Command="{x:Bind ViewModel.CancelActivityCommand}"
                        ToolTipService.ToolTip="Stop this job. Narration and pictures already made are kept, so starting again picks up faster." />
            </Grid>
            <!-- One bar for what happened: an error when there is one, otherwise the outcome of the last action. An outcome
                 goes by itself after a while; an error stays until it is closed. Both are kept under Messages, below. -->
            <InfoBar x:Name="MessageBar" AutomationProperties.LiveSetting="Assertive" Closed="OnMessageClosed" CornerRadius="10"
                     PointerEntered="OnMessageHeld" PointerExited="OnMessageLetGo" />
        </StackPanel>

        <!-- The strip along the foot of the window: anything not as it should be and the messages to read back on the left,
             and which build is running on the right, so a screenshot or a report of a fault says which one it was. -->
        <Grid Grid.Row="2" Padding="8,0,6,2" ColumnSpacing="{StaticResource Gap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Still connecting, running on stand-ins, FFmpeg not installed, and the last things the app said -->
            <Button x:Name="NoticeButton" Padding="6,1" MinHeight="0" FontSize="12" Background="Transparent" BorderThickness="0"
                    Visibility="{x:Bind local:Ui.ShowText(ViewModel.Notice), Mode=OneWay}"
                    ToolTipService.ToolTip="What is not running as it normally would, and the messages the app has shown, to read back.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE946;" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                        <StackPanel Width="360" Spacing="{StaticResource GapSmall}">
                            <TextBlock Text="{x:Bind ViewModel.NoticeDetail, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:Ui.ShowText(ViewModel.NoticeDetail), Mode=OneWay}" />
                            <HyperlinkButton Content="Get FFmpeg" Padding="0" NavigateUri="https://ffmpeg.org/download.html" Visibility="{x:Bind local:Ui.Hide(ViewModel.FfmpegAvailable)}" />
                            <TextBlock Text="Messages, newest first" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="MessageHistory" ItemsSource="{x:Bind ViewModel.Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource QuietText}" IsTextSelectionEnabled="True" Margin="0,0,0,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind local:App.BuildVersion}" Style="{StaticResource QuietText}" Opacity="0.6" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Build version" />
        </Grid>

        <!-- Sparks, smoke, gathering light, the finished thumbnail and confetti, over everything and never in the way of a click -->
        <views:FxLayer x:Name="Fx" Grid.RowSpan="3" />
    </Grid>
</winex:WindowEx>
