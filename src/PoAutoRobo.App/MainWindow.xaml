<winex:WindowEx
    x:Class="PoAutoRobo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:PoAutoRobo.App.ViewModels"
    xmlns:views="using:PoAutoRobo.App.Views"
    xmlns:local="using:PoAutoRobo.App"
    Title="PoAutoRobo"
    PersistenceId="Main"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="600">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Three steps: Topic, Clips, Export. One page shows at a time; the selector in the header moves between them. -->
    <Grid x:Name="Root">
        <!-- In a small window the column beside each page gives some of its width back to the page. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Tight">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- The header's buttons keep their signs and lose their words, which are in their tooltips, so the episode's title has room. -->
                        <Setter Target="Commands.DefaultLabelPosition" Value="Collapsed" />
                        <Setter Target="InspectorColumn.Width" Value="300" />
                        <Setter Target="ExportColumn.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnStepShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnStepShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnStepShortcut" />
            <!-- The clip loop from the keyboard: write, draw, copy, listen. Each does what its button does, when its button could. -->
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="OnCommandShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="G" Invoked="OnCommandShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="OnCommandShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnCommandShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: what you are making, anything amiss, every action for the episode, and where you are in the three steps -->
        <Grid Padding="{StaticResource HeaderPadding}" ColumnSpacing="{StaticResource GapSmall}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="EpisodeTitleText" Text="{x:Bind ViewModel.EpisodeTitle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.EpisodeTitle, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <!-- Written by the window, so the running time and cost roll to a new value instead of jumping. -->
                <TextBlock x:Name="MetaText" Style="{StaticResource QuietText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="Clips, length of the finished video (measured once a clip's voice is recorded, estimated from the word count until then), what the episode has cost, and how much the script and voice services have been used. Settings has the full breakdown." />
            </StackPanel>

            <!-- Anything not as it should be (still connecting, running on stand-ins, FFmpeg not installed), and the last things the app said -->
            <Button x:Name="NoticeButton" Grid.Column="1" VerticalAlignment="Center" Content="{x:Bind ViewModel.Notice, Mode=OneWay}" Visibility="{x:Bind local:Ui.ShowText(ViewModel.Notice), Mode=OneWay}"
                    ToolTipService.ToolTip="What is not running as it normally would, and the messages the app has shown, to read back.">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="360" Spacing="{StaticResource GapSmall}">
                            <TextBlock Text="{x:Bind ViewModel.NoticeDetail, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:Ui.ShowText(ViewModel.NoticeDetail), Mode=OneWay}" />
                            <HyperlinkButton Content="Get FFmpeg" Padding="0" NavigateUri="https://ffmpeg.org/download.html" Visibility="{x:Bind local:Ui.Hide(ViewModel.FfmpegAvailable)}" />
                            <TextBlock Text="Messages, newest first" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="MessageHistory" ItemsSource="{x:Bind ViewModel.Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource QuietText}" IsTextSelectionEnabled="True" Margin="0,0,0,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <CommandBar x:Name="Commands" Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center" AutomationProperties.Name="Episode actions">
                <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" LabelPosition="Collapsed" Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo the last change to the episode (Ctrl+Z)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" LabelPosition="Collapsed" Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo the change you undid (Ctrl+Y)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <!-- The two jobs that work on every clip at once, offered where the clips are -->
                <AppBarButton x:Name="NarrateAllButton" Icon="Microphone" Label="Record voices" Command="{x:Bind ViewModel.NarrateAllCommand}" Visibility="{x:Bind ViewModel.ShowDeck, Mode=OneWay}"
                              ToolTipService.ToolTip="Record every clip's voice now. Each card and the running time then show the real length, not an estimate, and previews build faster." />
                <AppBarButton x:Name="GenerateAllButton" Icon="Pictures" Label="Generate pictures" Command="{x:Bind ViewModel.GenerateAllCommand}" Visibility="{x:Bind ViewModel.ShowDeck, Mode=OneWay}"
                              ToolTipService.ToolTip="Draw a picture for every clip that needs one. You are shown the count and cost first; pictures you already have are reused free." />
                <!-- And all of it in one go: voices, pictures, then the finished video -->
                <AppBarButton x:Name="MakeAllButton" Icon="Play" Label="Make it all" Command="{x:Bind ViewModel.MakeAllCommand}" Visibility="{x:Bind ViewModel.HasEpisode, Mode=OneWay}"
                              ToolTipService.ToolTip="Record every voice, draw every picture still wanted, then render the master video, as one job. You are shown the plan and the cost once, and can then leave it to run." />
                <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Settings" LabelPosition="Collapsed" ToolTipService.ToolTip="Sounds, picture quality, a monthly budget, and what has been spent.">
                    <AppBarButton.Flyout>
                        <Flyout Opening="OnSettingsOpening">
                            <StackPanel Width="280" Spacing="{StaticResource GapSmall}">
                                <ToggleSwitch Header="Sounds" IsOn="{x:Bind ViewModel.SoundsOn, Mode=TwoWay}"
                                              ToolTipService.ToolTip="A chime when a long job finishes, a tick as each clip of a batch is done, a low note when something goes wrong, and the buttons' own clicks." />
                                <Slider Header="Volume" Minimum="0" Maximum="1" StepFrequency="0.05" IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.SoundVolume, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SoundsOn, Mode=OneWay}" />
                                <ToggleSwitch x:Name="DraftPicturesSwitch" Header="Draft-quality pictures" IsOn="{x:Bind ViewModel.DraftPictures, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Draw pictures at low quality: quicker and well under half the price. Turn it off and generate again for the pictures you will publish." />
                                <NumberBox x:Name="BudgetBox" Header="Monthly budget in dollars (0 for none)" Minimum="0" SmallChange="5" LargeChange="20" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MonthlyBudget, Mode=TwoWay}"
                                           ToolTipService.ToolTip="Once this month's spending across every episode would pass this, the app stops before making anything that costs money." />
                                <TextBlock Text="Spent" Style="{StaticResource SectionHeading}" />
                                <TextBlock x:Name="SpendText" Text="{x:Bind ViewModel.SpendDetail, Mode=OneWay}" Style="{StaticResource QuietText}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="HostButton" Label="Choose host…" Click="OnHostSetup" IsEnabled="{x:Bind ViewModel.PicturesAvailable, Mode=OneWay}"
                                  ToolTipService.ToolTip="Choose the cartoon robot that presents every episode. Once locked, every new picture keeps the same character." />
                    <AppBarButton x:Name="MixButton" Label="Look and visual mix…" Click="OnVisualMix" IsEnabled="{x:Bind ViewModel.HasEpisode, Mode=OneWay}"
                                  ToolTipService.ToolTip="Set the look of every picture, and what share of the plain clips are stills, panel sequences or title cards." />
                    <AppBarButton x:Name="ReviewItem" Label="Have an editor read the script" Command="{x:Bind ViewModel.ReviewScriptCommand}"
                                  ToolTipService.ToolTip="Reads the whole script for weak openings and clips that repeat one another, and marks the cards worth changing. Done once by itself when a script is written." />
                    <AppBarSeparator />
                    <AppBarButton x:Name="RenameEpisodeItem" Label="Rename episode…" Command="{x:Bind ViewModel.RenameEpisodeCommand}" />
                    <AppBarButton x:Name="ShowFolderItem" Label="Show the episode folder" Command="{x:Bind ViewModel.ShowEpisodeFolderCommand}" />
                    <AppBarButton x:Name="CleanMediaItem" Label="Remove unused media…" Command="{x:Bind ViewModel.CleanMediaCommand}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <controls:Segmented x:Name="StepSelector" Grid.Column="3" SelectedIndex="{x:Bind ViewModel.Step, Mode=TwoWay}" VerticalAlignment="Center"
                                AutomationProperties.Name="Step" ToolTipService.ToolTip="{x:Bind ViewModel.StepHint, Mode=OneWay}">
                <controls:SegmentedItem Content="1 · Topic" />
                <controls:SegmentedItem Content="2 · Clips" IsEnabled="{x:Bind ViewModel.HasEpisode, Mode=OneWay}" />
                <controls:SegmentedItem Content="3 · Export" IsEnabled="{x:Bind ViewModel.HasEpisode, Mode=OneWay}" />
            </controls:Segmented>
        </Grid>

        <!-- Everything the app has to tell you, in one place and on every step -->
        <StackPanel Grid.Row="1">
            <!-- The one long job in progress: what it is, the exact step, how far, how long, and a way to stop it -->
            <Grid x:Name="ActivityPanel" Padding="16,10" ColumnSpacing="{StaticResource GapLarge}" Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay}"
                  Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock x:Name="ActivityTitleText" Text="{x:Bind ViewModel.ActivityTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ActivityTimeText" Text="{x:Bind ViewModel.ActivityTime, Mode=OneWay}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource Gap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="RenderProgressBar" Maximum="100" Height="8" VerticalAlignment="Center" Value="{x:Bind ViewModel.ActivityPercent, Mode=OneWay}" />
                        <!-- Counted up by the window, so the figure rolls to its new value instead of jumping. -->
                        <TextBlock x:Name="ActivityPercentText" Grid.Column="1" Text="0%" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="ActivityDetailText" Text="{x:Bind ViewModel.ActivityDetail, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ActivityDetail, Mode=OneWay}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button x:Name="CancelActivityButton" Grid.Column="1" Content="Cancel" MinWidth="96" MinHeight="44" VerticalAlignment="Center" Command="{x:Bind ViewModel.CancelActivityCommand}"
                        ToolTipService.ToolTip="Stop this job. Narration and pictures already made are kept, so starting again picks up faster." />
            </Grid>
            <!-- One bar for what happened: an error when there is one, otherwise the outcome of the last action -->
            <InfoBar x:Name="MessageBar" AutomationProperties.LiveSetting="Assertive" Closed="OnMessageClosed">
                <InfoBar.ActionButton>
                    <Button x:Name="ShowExportButton" Content="Show in folder" Command="{x:Bind ViewModel.ShowExportCommand}" Visibility="{x:Bind ViewModel.HasExport, Mode=OneWay}"
                            ToolTipService.ToolTip="Open the folder holding the finished video and everything made to upload with it." />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- The pages. Each slides in as it is shown. -->
        <Grid Grid.Row="2">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- Step 1 · Topic -->
            <views:TopicPage x:Name="Topic" ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.ShowTopic, Mode=OneWay}" />

            <!-- Step 2 · Clips: the deck, with the selected clip's words and picture beside it -->
            <Grid x:Name="DeckPage" Visibility="{x:Bind ViewModel.ShowDeck, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="{StaticResource InspectorColumn}" />
                </Grid.ColumnDefinitions>
                <GridView x:Name="ClipDeck" Padding="{StaticResource DeckPadding}" ItemsSource="{x:Bind ViewModel.Clips}"
                          SelectedItem="{x:Bind ViewModel.SelectedClip, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Clips in running order"
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True" ContainerContentChanging="OnCardShown" SelectionChanged="OnCardSelected" KeyDown="OnDeckKey">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClipViewModel">
                            <views:ClipCard x:Name="CardRoot" Card="{x:Bind}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <views:InspectorView x:Name="Inspector" ViewModel="{x:Bind ViewModel}" />
                </Border>

                <!-- While the script is written: placeholder cards in the shape of what is coming, each taking its clip's title as it arrives -->
                <Grid Grid.ColumnSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay}">
                    <GridView x:Name="Skeleton" Padding="{StaticResource DeckPadding}" ItemsSource="{x:Bind ViewModel.Skeletons, Mode=OneWay}" SelectionMode="None" IsHitTestVisible="False" IsTabStop="False"
                              AutomationProperties.AccessibilityView="Raw">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Width="{StaticResource CardWidth}" Spacing="{StaticResource GapSmall}" Padding="4">
                                    <Border Height="{StaticResource CardPictureHeight}" CornerRadius="4" Background="{StaticResource ShimmerBrush}" />
                                    <Border Height="14" Width="150" CornerRadius="4" HorizontalAlignment="Left" Background="{StaticResource ShimmerBrush}"
                                            Visibility="{x:Bind local:Ui.HideText((x:String))}" />
                                    <TextBlock Text="{x:Bind}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind local:Ui.ShowText((x:String))}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Grid>

            <!-- Step 3 · Export: the preview takes the room there is; captions, music and the finished videos sit beside it -->
            <Grid x:Name="ExportPage" Padding="{StaticResource PagePadding}" ColumnSpacing="{StaticResource GapLarge}" Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Step, 2), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ExportColumn" Width="{StaticResource ExportColumn}" />
                </Grid.ColumnDefinitions>
                <views:TimelineView ViewModel="{x:Bind ViewModel}" />
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Captions" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="CaptionPresetBox" ToolTipService.ToolTip="How the burned-in captions look. The preview updates as soon as you change this." HorizontalAlignment="Stretch" AutomationProperties.Name="Caption style"
                                  ItemsSource="{x:Bind ViewModel.CaptionChoices}" SelectedIndex="{x:Bind ViewModel.CaptionPresetIndex, Mode=TwoWay}" />
                        <Slider Header="Font size" Minimum="32" Maximum="96" StepFrequency="2" Value="{x:Bind ViewModel.CaptionFontSize, Mode=TwoWay}" />
                        <Slider Header="Outline" Minimum="0" Maximum="10" StepFrequency="1" Value="{x:Bind ViewModel.CaptionStroke, Mode=TwoWay}" />
                        <!-- The colour picker is far taller than this column has room for, so it alone opens beside it. -->
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="44" AutomationProperties.Name="Accent colour" ToolTipService.ToolTip="The colour of the word being spoken, or of the banner behind the words.">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}">
                                <Border Width="20" Height="20" CornerRadius="4">
                                    <Border.Background>
                                        <SolidColorBrush Color="{x:Bind ViewModel.CaptionAccent, Mode=OneWay}" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Accent colour" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Left">
                                    <ColorPicker IsAlphaEnabled="False" IsMoreButtonVisible="False" IsColorSliderVisible="True" IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="True" Color="{x:Bind ViewModel.CaptionAccent, Mode=TwoWay}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <TextBlock Text="Music" Style="{StaticResource SectionHeading}" />
                        <Button x:Name="MusicButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="44" Click="OnPickMusic" Content="{x:Bind ViewModel.MusicLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="Choose a music file to play quietly under the narration. It repeats to the video's length and dips whenever the voice speaks. Use music you have the right to publish." />
                        <Button x:Name="RemoveMusicButton" HorizontalAlignment="Stretch" MinHeight="44" Content="Remove the music" Command="{x:Bind ViewModel.RemoveMusicCommand}" Visibility="{x:Bind ViewModel.HasMusic, Mode=OneWay}" />

                        <TextBlock Text="Finished videos" Style="{StaticResource SectionHeading}" />
                        <ComboBox x:Name="ExportPresetBox" ToolTipService.ToolTip="Size and smoothness of the master video. 4K and 60 fps take much longer to render." HorizontalAlignment="Stretch" AutomationProperties.Name="Export quality"
                                  ItemsSource="{x:Bind ViewModel.ExportChoices}" SelectedIndex="{x:Bind ViewModel.ExportPresetIndex, Mode=TwoWay}" />
                        <!-- The thing to do next once there is a preview; until then that is building the preview, on the screen beside this. -->
                        <Button x:Name="RenderButton" HorizontalAlignment="Stretch" MinHeight="44" Content="Render master video" Style="{x:Bind local:Ui.Primary(ViewModel.HasPreview), Mode=OneWay}" Command="{x:Bind ViewModel.RenderCommand}"
                                ToolTipService.ToolTip="Build the finished video file with voice, pictures and captions, plus a chapter list, subtitles, a thumbnail and an upload description. A full episode can take several minutes the first time; clips that have not changed since the last render are not drawn again." />
                        <Button x:Name="ShortsButton" HorizontalAlignment="Stretch" MinHeight="44" ToolTipService.ToolTip="Build one upright 1080 by 1920 video for each clip, captions included, for phone-first video sites." Content="Render a short per clip" Command="{x:Bind ViewModel.RenderShortsCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</winex:WindowEx>
