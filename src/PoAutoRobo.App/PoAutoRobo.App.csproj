<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Built against the newer Windows kit the shader package asks for; the oldest Windows it runs on is the line below, unchanged. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PoAutoRobo.App</RootNamespace>
    <!-- Follow the machine building it (x64 or ARM64); a fixed value fails to start on the other. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: runs as a plain exe, with the Windows App SDK runtime copied alongside it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The backdrop shader is turned into the graphics card's language at build time, by code that works with raw memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Beside the exe as well as inside it: the window's title bar and taskbar button read the file. -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoAutoRobo.Core\PoAutoRobo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="ComputeSharp.D2D1.WinUI" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <!-- The build version shown in the window's corner: the day of the last commit as YYMMDD, in this machine's time
       like the fallback, then the commit itself, so two builds from one day can be told apart. A + after it means the
       code had changes not yet committed. Building the same commit again gives the same version. Today's date alone
       when git is missing or this is not a clone: its complaint goes to nul, so nothing comes back. -->
  <Target Name="StampBuildVersion" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git log -1 --format=%25%25cd --date=format-local:%25%25y%25%25m%25%25d 2&gt;nul" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CommitDay" />
    </Exec>
    <!-- Tags are left out so this is always the bare commit, never a tag name. -->
    <Exec Command="git describe --always --abbrev=7 --exclude=* --dirty=+ 2&gt;nul" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CommitId" />
    </Exec>
    <PropertyGroup>
      <BuildVersion Condition="'$(CommitDay.Trim())' != ''">$(CommitDay.Trim()) $(CommitId.Trim())</BuildVersion>
      <BuildVersion Condition="'$(BuildVersion)' == ''">$([System.DateTime]::Now.ToString('yyMMdd'))</BuildVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="BuildVersion" Value="$(BuildVersion)" />
    </ItemGroup>
  </Target>

</Project>
